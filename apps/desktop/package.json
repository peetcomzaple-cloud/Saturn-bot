{
  "name": "@rakazo/desktop",
  "productName": "Saturn bot",
  "version": "0.1.6",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "pnpm generate:window-theme && tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "pack": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --mac --win --linux",
    "pack:dir": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --dir",
    "check": "pnpm generate:window-theme && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "release": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --publish never",
    "generate:window-theme": "tsx scripts/generate-window-theme.ts"
  },
  "dependencies": {
    "@rakazo/contracts": "workspace:*",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@rakazo/ui-tokens": "workspace:*",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "dev.saturnbot.desktop",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../infra/compose/docker-compose.images.yml",
        "to": "stack/docker-compose.images.yml"
      },
      {
        "from": "../../infra/compose/.env.images.example",
        "to": "stack/.env.images.example"
      }
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "../../packages/ui-tokens/assets/Saturn.icon",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": true
    },
    "win": {
      "icon": "assets/saturn-logo.png",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true
    },
    "linux": {
      "executableName": "saturn-bot",
      "icon": "assets/saturn-logo.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "peetcomzaple-cloud",
        "repo": "saturn-bot"
      }
    ]
  },
  "description": "Desktop client adapted for Saturn bot; see PROVENANCE.md."
}
