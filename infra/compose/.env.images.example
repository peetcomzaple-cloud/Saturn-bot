# Sanitized template for the pull-based stack (docker-compose.images.yml).
# Empty secret values are filled with random hex when this file is first turned into `.env`
# (by the desktop app or by install-images.sh). Never commit a real `.env`.
# Image tags (RAKAZO_IMAGE_TAG, RAKAZO_COMPUTER_IMAGE_TAG) are supplied per launch by the
# launcher and intentionally not set here.

POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
SCREEN_PROXY_SECRET=
SANDBOX_SUPERVISOR_TOKEN=

# Images built from this repository's sources. Change only to use images you built or mirrored.
RAKAZO_IMAGE=ghcr.io/peetcomzaple-cloud/saturn-bot/app
RAKAZO_COMPUTER_IMAGE=ghcr.io/peetcomzaple-cloud/saturn-bot/computer

# Local Linux desktop containers via the in-stack supervisor.
SANDBOX_PROVIDER=docker

# Per-computer limits are chosen in the desktop app's setup window and passed at launch.
# They apply to computers created after the stack next starts; running computers keep theirs.
# To run the compose file by hand instead, uncomment and edit:
# RAKAZO_COMPUTER_MEMORY=2g
# RAKAZO_COMPUTER_CPUS=2

# Outbound network policy for computers: open (default) or restricted.
SANDBOX_COMPUTER_EGRESS=open
