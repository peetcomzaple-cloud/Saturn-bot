      for (const node of nodes) {
        if (!visible(node)) continue;
        const win = (node.ownerDocument && node.ownerDocument.defaultView) || window;
        const style = win.getComputedStyle ? win.getComputedStyle(node) : null;
        const rect = node.getBoundingClientRect();
        const isOverlay =
          node.getAttribute("role") === "dialog" ||
          node.getAttribute("aria-modal") === "true" ||
          node.tagName.toLowerCase() === "dialog" ||
          (style && (style.position === "fixed" || style.position === "absolute") && rect.width >= 200 && rect.height >= 100);
        if (isOverlay) {
          const desc = `${node.tagName.toLowerCase()}${node.id ? `#${node.id}` : ""}`;
          return { node, desc };
        }
      }
    }
    return null;
  }

  function formatTree(elements, includeRef = true) {
    if (!elements.length) return "(no interactive elements)";
    return elements
      .map((el) => {
        const value =
          el.value !== undefined && el.value !== "" ? ` value=${JSON.stringify(el.value)}` : "";
        const refStr = includeRef && el.ref ? ` [${el.ref}]` : "";
        const ctxStr = el.context ? ` (in: ${JSON.stringify(el.context)})` : "";
        const modalStr = el.isModal ? " [modal]" : "";
        const occStr = el.occludedBy ? ` [occluded by ${el.occludedBy}]` : "";
        return `- ${el.role} "${el.name}"${refStr}${value}${ctxStr}${modalStr}${occStr}`;
      })
      .join("\n");
  }

  function scanElements() {
    const candidates = [];
    const seen = new Set();
    let hasFrames = false;
    let hasClosedShadow = false;
    const frameTexts = [];
    const shadowTexts = [];
    const activeModalInfo = detectActiveModalOverlay();
    let detectedBlockerDesc = activeModalInfo ? activeModalInfo.desc : null;

    function walk(root, inShadow = false, inFrame = false) {
      const nodes = root.querySelectorAll ? Array.from(root.querySelectorAll("*")) : [];
      for (const el of nodes) {
        if (
          (window.__rakazoClosedShadows && window.__rakazoClosedShadows.has(el)) ||
          (el.getAttribute && (el.getAttribute("data-rakazo-closed-shadow") === "1" || el.getAttribute("data-shadow-mode") === "closed"))
        ) {
          hasClosedShadow = true;
        }
        if (el.shadowRoot) {
          const sText = (el.shadowRoot.innerText || el.shadowRoot.textContent || "").replace(/\s+/g, " ").trim();
          if (sText) shadowTexts.push(`[Shadow DOM]: ${sText}`);
          walk(el.shadowRoot, true, inFrame);
        }
        const tag = el.tagName ? el.tagName.toLowerCase() : "";
        if (tag === "iframe" || tag === "frame") {
          if (visible(el)) {
            try {
              const doc = el.contentDocument;
              const childCount = doc && doc.body && doc.body.children ? doc.body.children.length : 0;
              if (doc && doc.body) {
                const fText = (doc.body.innerText || doc.body.textContent || "").trim();
                if (fText) frameTexts.push(fText);
                if (!fText && childCount === 0) {
                  hasFrames = true;
                } else {
                  walk(doc.body, inShadow, true);
                }
              } else {
                hasFrames = true;
              }
            } catch {
              hasFrames = true;
            }
          }
          continue;
        }
        if (!isInteractive(el) || !visible(el)) continue;

        if (el.shadowRoot && el.shadowRoot.querySelector && el.shadowRoot.querySelector("button, input, a, textarea, select")) {
          continue;
        }

        if (seen.has(el)) continue;
        seen.add(el);

        let name = nameOf(el);
        const host = el.getRootNode && el.getRootNode().host;
        if (!name && host) {
          name = nameOf(host);
        }

        const disabled = isDisabled(el);
        const role = roleOf(el);
        const occ = detectElementOcclusion(el);
        if (occ && !detectedBlockerDesc) {
          detectedBlockerDesc = occ.blockerDesc;
        }
        const insideActiveModal = Boolean(
          activeModalInfo && activeModalInfo.node && containsAcrossShadow(activeModalInfo.node, el)
        );
        candidates.push({
          node: el,
          role,
          name: String(name).slice(0, 200),
          value: el.type === "password" || loginFilled.has(el) ? undefined
            : ["checkbox", "radio"].includes(el.type) ? (el.checked ? "checked" : "unchecked")
            : "value" in el ? String(el.value ?? "").slice(0, 2000)
            : el.isContentEditable ? String(el.innerText || el.textContent || "").trim().slice(0, 2000)
            : undefined,
          tag,
          ...(disabled ? { disabled: true } : {}),
          ...(inShadow ? { inShadowDom: true } : {}),
          ...(inFrame ? { inIframe: true } : {}),
          ...(insideActiveModal ? { isModal: true } : {}),
          ...(occ ? { occluded: true, occludedBy: occ.blockerDesc } : {}),
