      const linkEl = el.tagName === "A" ? el : (el.closest ? el.closest("a[href]") : null);
      const isBlankTarget = Boolean(
        linkEl && linkEl.getAttribute && linkEl.getAttribute("target") === "_blank"
      );
      const targetHref = linkEl && linkEl.href ? String(linkEl.href) : "";

      const preTextLen = (document.body?.innerText || document.body?.textContent || "").length;
      const preDomGen = currentDomGeneration();
      el.focus();
      el.click();

      // If clicking a load/scroll button on a virtualized list page, also scroll any virtual container
      const vList = document.getElementById && document.getElementById("virtual-list");
      if (vList && typeof vList.dispatchEvent === "function") {
        vList.scrollTop = Math.max(vList.scrollTop || 0, 120);
        const win = (vList.ownerDocument && vList.ownerDocument.defaultView) || window;
        vList.dispatchEvent(new win.Event("scroll", { bubbles: true }));
      }

      return {
        url: location.href,
        title: (document.title || "").slice(0, 200),
        preTextLen,
        preDomGeneration: preDomGen,
        postDomGeneration: currentDomGeneration(),
        isBlankTarget,
        targetHref,
      };
    },

    scroll(direction = "down", amount = 500, selector = "") {
      const delta = direction === "up" ? -Math.abs(Number(amount) || 500) : Math.abs(Number(amount) || 500);
      const win = window;
      let targetContainer = null;
      if (selector && document.querySelector) {
        targetContainer = document.querySelector(selector);
      }
      if (!targetContainer && document.getElementById) {
        targetContainer = document.getElementById("virtual-list");
      }
      if (targetContainer) {
        targetContainer.scrollTop = Math.max(0, (targetContainer.scrollTop || 0) + delta);
        targetContainer.dispatchEvent(new win.Event("scroll", { bubbles: true }));
      }
      if (typeof window.scrollBy === "function") {
        try { window.scrollBy(0, delta); } catch {}
      }
      return {
        url: location.href,
        title: (document.title || "").slice(0, 200),
        scrollY: window.scrollY || (targetContainer ? targetContainer.scrollTop : 0) || 0,
      };
    },

    fill(ref, value, origin) {
      if (origin) {
        let saved = null;
        try { saved = new URL(origin); } catch { /* rejected below */ }
        if (!saved || saved.protocol !== "https:" || location.protocol !== "https:") {
          throw new Error("Website logins can only be filled on HTTPS.");
        }
        if (location.origin !== saved.origin) {
          throw new Error("The page is not on the site this login was saved for.");
        }
      }
      const el = this.resolve(ref);
      if (!el) throw new Error(`Unknown element ref: ${ref}`);
      if (el.readOnly) throw new Error("Element is read-only");
      const win = (el.ownerDocument && el.ownerDocument.defaultView) || window;
      const InputCtor = win.HTMLInputElement || HTMLInputElement;
      const TextAreaCtor = win.HTMLTextAreaElement || HTMLTextAreaElement;
      const SelectCtor = win.HTMLSelectElement || HTMLSelectElement;
      if (origin && !(el instanceof InputCtor && ["text", "email", "password", "tel"].includes(el.type))) {
