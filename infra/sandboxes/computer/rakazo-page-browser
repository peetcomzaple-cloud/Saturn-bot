      ? "bot_challenge"
      : hasMfaInput
        ? "mfa_challenge"
        : undefined;

    return {
      rawElements,
      hasFrames,
      hasClosedShadow,
      frameTexts,
      shadowTexts,
      isModal: Boolean(detectedBlockerDesc),
      activeModal: detectedBlockerDesc || undefined,
      challengeDetected: Boolean(challengeType),
      challengeType,
    };
