    walk(document.body || document, false, false);

    // Disambiguate repeated (role, name) pairs using nearest row/card/item container context
    const sigCounts = new Map();
    for (const item of candidates) {
      const sig = `${item.role}:${(item.name || "").toLowerCase()}`;
      sigCounts.set(sig, (sigCounts.get(sig) || 0) + 1);
    }
    const sigSeen = new Map();
    for (const item of candidates) {
      const sig = `${item.role}:${(item.name || "").toLowerCase()}`;
      if ((sigCounts.get(sig) || 0) > 1) {
        const idx = (sigSeen.get(sig) || 0) + 1;
        sigSeen.set(sig, idx);
        const ctx = contextOf(item.node, item.name);
        item.context = ctx ? `${ctx} (#${idx})` : `#${idx}`;
      }
    }

    let rawElements = candidates;
    if (candidates.length > 80) {
      const formRoles = new Set(["textbox", "combobox", "searchbox", "checkbox", "radio", "switch"]);
      const bySig = new Map();
      candidates.forEach((item, idx) => {
        if (!formRoles.has(item.role) && item.name) {
          const sig = `${item.role}:${item.name}:${item.context || ""}`;
          if (!bySig.has(sig)) bySig.set(sig, []);
          bySig.get(sig).push(idx);
        }
      });
      const skipIndices = new Set();
      for (const indices of bySig.values()) {
        if (indices.length > 4) {
          for (let i = 2; i < indices.length - 2; i++) {
            skipIndices.add(indices[i]);
          }
        }
      }
      const deduped = candidates.filter((_, idx) => !skipIndices.has(idx));
      if (deduped.length <= 120) {
        rawElements = deduped;
      } else {
        const mustKeep = new Set();
        deduped.forEach((item, idx) => {
          if (formRoles.has(item.role) || ["input", "textarea", "select"].includes(item.tag)) {
            mustKeep.add(idx);
          }
        });
        for (let idx = deduped.length - 1; idx >= 0 && mustKeep.size < 40; idx--) {
          mustKeep.add(idx);
        }
        for (let idx = 0; idx < deduped.length && mustKeep.size < 120; idx++) {
          mustKeep.add(idx);
        }
        rawElements = deduped.filter((_, idx) => mustKeep.has(idx));
      }
