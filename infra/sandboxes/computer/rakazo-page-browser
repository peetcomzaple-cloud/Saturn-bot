        text: combined,
        truncated: false,
        totalTextLength: combined.length,
        scrollY,
        scrollHeight,
        viewportHeight,
      };
    }
    const maxScroll = Math.max(1, (scrollHeight || 1) - viewportHeight);
    const scrollRatio = Math.min(1, Math.max(0, scrollY / maxScroll));
    let sliced = "";
