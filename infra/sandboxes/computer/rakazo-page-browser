      if (hasClosedShadow) notes += "\nClosed Shadow DOM components require desktop tools.";
      const extracted = extractPageText(frameTexts, shadowTexts);
      if (extracted.truncated) {
        notes += `\n[Document Truncated: showing excerpts of ${extracted.totalTextLength} total characters.]`;
      }
      const contentStatus = detectContentStatus();
