          raw.slice(0, 4000) +
          "\n...[truncated]...\n" +
          raw.slice(midStart, midEnd) +
          "\n...[truncated]...\n" +
          raw.slice(-5000) +
          extra.slice(0, 2000);
      }
    }
    if (!sliced) {
      sliced = raw.slice(0, 7000) + "\n...[truncated]...\n" + raw.slice(-7000) + extra.slice(0, 2000);
    }
    return {
      text: sliced,
      truncated: true,
      totalTextLength: combined.length,
      scrollY,
      scrollHeight,
      viewportHeight,
    };
