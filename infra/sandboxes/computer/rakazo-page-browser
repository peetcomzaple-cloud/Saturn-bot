def attach_page(client: CdpClient) -> str:
    targets = client.call("Target.getTargets").get("targetInfos") or []
    pages = [t for t in targets if isinstance(t, dict) and t.get("type") == "page"]
    if not pages:
        try:
            created = client.call("Target.createTarget", {"url": "about:blank"})
            if isinstance(created, dict) and created.get("targetId"):
                pages = [{"targetId": created["targetId"], "type": "page", "url": "about:blank"}]
        except Exception:
            pass
    candidates = []
    session_by_tid: dict[str, str] = {}
    opener_map = getattr(client, "_opener_map", None)
    session_to_target = getattr(client, "_session_to_target", None)
    attached_sessions: list[str] = []
    failed_target_ids: set[str] = set()
    for page in pages[:32]:
        tid = str(page.get("targetId") or "")
        opener_tid = str(page.get("openerId") or "")
        if tid and opener_tid and isinstance(opener_map, dict):
            opener_map[tid] = opener_tid
        attached = client.call("Target.attachToTarget", {
            "targetId": page["targetId"], "flatten": True,
        })
        session_id = attached["sessionId"]
        attached_sessions.append(session_id)
        if tid:
            session_by_tid[tid] = session_id
            if isinstance(session_to_target, dict):
                session_to_target[session_id] = tid
        if isinstance(getattr(client, "_session_targets", None), dict):
            client._session_targets[session_id] = {
                "targetId": str(page.get("targetId") or ""),
                "browserContextId": str(page.get("browserContextId") or ""),
            }
        try:
            client.call("Page.enable", session_id=session_id, timeout_s=3.0)
            client.call("Network.enable", session_id=session_id)
            try:
                client.call(
                    "Page.addScriptToEvaluateOnNewDocument",
                    {"source": CLOSED_SHADOW_INIT_SCRIPT},
                    session_id=session_id,
                )
            except Exception:
                pass
            ensure_world(client, session_id)
            info = eval_json(
                client,
                session_id,
                '({visible: document.visibilityState === "visible", focused: document.hasFocus(), isPopup: Boolean(window.opener)})',
            )
            if isinstance(info, dict) and info.get("visible"):
                candidates.append((session_id, bool(info.get("focused")), bool(info.get("isPopup"))))
            elif info is True:
                focused = eval_json(client, session_id, "document.hasFocus()")
                candidates.append((session_id, bool(focused), False))
        except Exception:
            # An attachment is not proof that its renderer is responsive.
            failed_target_ids.add(tid)
            session_by_tid.pop(tid, None)
            attached_sessions.remove(session_id)
            continue
    preferred_tid = getattr(client, "_active_target_id", None)
    if preferred_tid in failed_target_ids:
        raise RuntimeError("Selected browser target is unresponsive; refusing another tab")
    if (
        isinstance(preferred_tid, str)
        and preferred_tid not in session_by_tid
        and isinstance(opener_map, dict)
    ):
        opener_of_closed = opener_map.get(preferred_tid)
        if isinstance(opener_of_closed, str) and opener_of_closed in session_by_tid:
            preferred_tid = opener_of_closed
    focused = [session for session, focus, _is_popup in candidates if focus]
    popups = [session for session, _focus, is_popup in candidates if is_popup]
    if isinstance(preferred_tid, str) and preferred_tid in session_by_tid:
        selected = session_by_tid[preferred_tid]
    elif len(focused) == 1:
        selected = focused[0]
    elif len(candidates) == 1:
        selected = candidates[0][0]
    elif len(popups) == 1:
        selected = popups[0]
    elif candidates and isinstance(opener_map, dict) and opener_map:
        selected = candidates[-1][0]
    elif len(attached_sessions) == 1:
        selected = attached_sessions[0]
        try:
            client.call("Page.bringToFront", session_id=selected)
        except Exception:
            pass
    else:
        raise RuntimeError("No unambiguous visible browser tab. Use desktop tools to select a tab.")
    if isinstance(session_to_target, dict) and selected in session_to_target:
        client._active_target_id = session_to_target[selected]
    if isinstance(getattr(client, "_session_targets", None), dict):
        selected_meta = client._session_targets.get(selected) or {}
        if selected_meta.get("targetId"):
            client._active_target_id = selected_meta["targetId"]
        if selected_meta.get("browserContextId"):
            client._active_browser_context_id = selected_meta["browserContextId"]
    ensure_world(client, selected)
    try:
        client.call("Security.setIgnoreCertificateErrors", {"ignore": False}, session_id=selected)
    except Exception:
        pass
    download_dir = os.environ.get("RAKAZO_DOWNLOAD_DIR") or os.path.expanduser("~/Downloads")
    client._active_download_dir = download_dir
    behavior_params: dict[str, Any] = {
        "behavior": "allow",
        "downloadPath": download_dir,
        "eventsEnabled": True,
    }
    if isinstance(getattr(client, "_active_browser_context_id", None), str) and client._active_browser_context_id:
        behavior_params["browserContextId"] = client._active_browser_context_id
    try:
        client.call("Browser.setDownloadBehavior", behavior_params)
    except Exception:
        if "browserContextId" in behavior_params:
            try:
                fallback_params = {k: v for k, v in behavior_params.items() if k != "browserContextId"}
                client.call("Browser.setDownloadBehavior", fallback_params)
            except Exception:
                pass
    return selected


def record_target_observation(
    client: Any,
    target_id: str | None,
    url: str,
    title: str,
    dom_gen: int | None = None,
    snap_gen: int | None = None,
) -> None:
    if not target_id:
        return
    opener_map = getattr(client, "_opener_map", None)
    opener_id = opener_map.get(target_id) if isinstance(opener_map, dict) else None
    history = getattr(client, "_target_history", None)
    if isinstance(history, list):
        entry = {
            "targetId": target_id,
            "openerTargetId": opener_id,
            "url": url,
            "title": title,
            "domGeneration": dom_gen,
            "snapshotGeneration": snap_gen,
            "ts": round(time.time(), 3),
        }
        if not history or history[-1].get("targetId") != target_id or history[-1].get("url") != url or history[-1].get("domGeneration") != dom_gen:
            history.append(entry)


def list_browser_tabs(client: Any, active_session_id: str | None = None) -> list[dict[str, Any]]:
    if not hasattr(client, "call"):
        return []
    try:
        targets = client.call("Target.getTargets").get("targetInfos") or []
    except Exception:
        return []
    pages = [t for t in targets if isinstance(t, dict) and t.get("type") == "page"]
    active_tid = getattr(client, "_active_target_id", None)
    session_to_target = getattr(client, "_session_to_target", None)
    if active_session_id and isinstance(session_to_target, dict) and active_session_id in session_to_target:
        active_tid = session_to_target[active_session_id]
    opener_map = getattr(client, "_opener_map", None)
    target_gens = getattr(client, "_target_generations", None)
    tabs: list[dict[str, Any]] = []
    for page in pages[:32]:
        tid = str(page.get("targetId") or "")
        if not tid:
            continue
        opener_tid = str(page.get("openerId") or "") or (
            opener_map.get(tid) if isinstance(opener_map, dict) else ""
        )
        if opener_tid and isinstance(opener_map, dict):
            opener_map[tid] = opener_tid
        tab_entry: dict[str, Any] = {
            "targetId": tid,
            "openerTargetId": opener_tid or None,
            "url": str(page.get("url") or ""),
            "title": str(page.get("title") or ""),
            "active": bool(tid == active_tid),
        }
        if isinstance(target_gens, dict) and tid in target_gens:
            tab_entry["snapshotGeneration"] = target_gens[tid]
        tabs.append(tab_entry)
    return tabs

list_open_tabs = list_browser_tabs


def _collect_frame_tree_ids(tree_node: Any) -> set[str]:
    out: set[str] = set()
    if not isinstance(tree_node, dict):
        return out
    frame = tree_node.get("frame")
    if isinstance(frame, dict) and isinstance(frame.get("id"), str) and frame["id"]:
        out.add(frame["id"])
    children = tree_node.get("childFrames")
    if isinstance(children, list):
        for child in children:
            out.update(_collect_frame_tree_ids(child))
    return out


def ensure_world(client: CdpClient, session_id: str) -> None:
    # Rediscover only an isolated context bound to this frame and CDP session.
    # Never run helpers in a page-owned default context with the same name.
    frame_tree = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]
    frame = frame_tree["frame"]
    frame_id = frame["id"]
    if isinstance(frame_id, str) and frame_id:
        client._active_frame_id = frame_id
        client._active_frame_ids = _collect_frame_tree_ids(frame_tree)
        if isinstance(getattr(client, "_session_targets", None), dict):
            client._session_targets.setdefault(session_id, {})["frameId"] = frame_id
    client.call("Runtime.enable", session_id=session_id)
    existing = client.find_world_context(WORLD_NAME, frame_id, session_id)
    if existing is not None:
        client.context_id = existing
        return
    world = client.call("Page.createIsolatedWorld", {
        "frameId": frame_id, "worldName": WORLD_NAME,
    }, session_id=session_id)
    client.context_id = world["executionContextId"]


