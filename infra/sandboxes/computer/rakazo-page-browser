#!/usr/bin/env python3
"""Drive the live Chromium on this computer over CDP (stdlib only).

Attaches to the Chrome already showing on DISPLAY. Used by the host
BrowserProvider. Not a vendor SDK. On failure prints JSON with
fallback computer_act.
"""

from __future__ import annotations

import base64
import hashlib
import json
import os
import socket
import struct
import sys
import tempfile
import time
import threading
import urllib.request
from urllib.parse import urlsplit
from typing import Any


def display_num() -> int:
    raw = os.environ.get("DISPLAY", ":1")
    try:
        return int(str(raw).lstrip(":").split(".")[0] or "1")
    except ValueError:
        return 1


def cdp_port() -> int:
    override = os.environ.get("RAKAZO_CDP_PORT")
    if override:
        return int(override)
    # rakazo-browser uses 9221 + display number (:1 -> 9222).
    return 9221 + display_num()


def default_state_file(port: int | None = None) -> str:
    override = os.environ.get("RAKAZO_BROWSER_STATE_FILE")
    if override:
        return override
    resolved_port = port if port is not None else cdp_port()
    return os.path.join(tempfile.gettempdir(), f"rakazo-page-browser-state-{resolved_port}.json")


def http_get_json(url: str, timeout: float = 5.0) -> Any:
    with urllib.request.urlopen(url, timeout=timeout) as resp:
        data = resp.read(1024 * 1024 + 1)
        if len(data) > 1024 * 1024:
            raise RuntimeError("CDP discovery response too large")
        return json.loads(data.decode("utf-8"))


def wait_for_cdp(port: int, timeout_s: float = 3.0) -> None:
    deadline = time.time() + timeout_s
    last_error = "unreachable"
    launched = False
    while time.time() < deadline:
        try:
            http_get_json(f"http://127.0.0.1:{port}/json/version", timeout=1.0)
            return
        except Exception as exc:  # noqa: BLE001
            last_error = str(exc)
            if (
                not launched
                and port > 0
                and os.path.isfile("/usr/local/bin/rakazo-focus-or-launch")
            ):
                launched = True
                try:
                    import subprocess

                    subprocess.Popen(
                        ["/usr/local/bin/rakazo-focus-or-launch", "rakazo-browser"],
                        stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True,
                    )
                    deadline = max(deadline, time.time() + 6.0)
                except Exception:
                    pass
            time.sleep(0.25)
    raise RuntimeError(f"CDP not ready on port {port}: {last_error}")


def discover_ws_url(port: int) -> str:
    version = http_get_json(f"http://127.0.0.1:{port}/json/version")
    ws = version.get("webSocketDebuggerUrl")
    if not isinstance(ws, str) or not ws:
        raise RuntimeError("CDP version endpoint missing webSocketDebuggerUrl")
    parsed = urlsplit(ws)
    if parsed.scheme != "ws" or parsed.hostname != "127.0.0.1" or parsed.port != port:
        raise RuntimeError("Unexpected CDP endpoint")
    return ws


WORLD_NAME = "rakazo-page-browser"


class BrowserEvidence:
    def __init__(self, run_id, execution_id, command, *, now=time.time):
        self.enabled = self.valid_id(run_id) and self.valid_execution(execution_id)
        self.run_id, self.execution_id, self.command = run_id, execution_id, command
        self.now, self.events, self.requests, self.sessions = now, [], {}, {}
        self.session, self.target, self.incomplete = None, None, False
        self.started_at = now()

    @staticmethod
    def valid_id(value):
        return isinstance(value, str) and 0 < len(value) <= 200 and all(
            ch.isascii() and (ch.isalnum() or ch in '._:-') for ch in value)

    @staticmethod
    def valid_execution(value):
        if not isinstance(value, str) or not value.strip() or any(ord(c) < 32 or ord(c) == 127 for c in value):
            return False
        try:
            return len(value.encode('utf-8')) <= 2048
        except UnicodeError:
            return False

    @staticmethod
    def url_fingerprint(value):
        # Preserve path and query distinctions, never persist a raw URL or userinfo.
        parsed = urlsplit(value)
        if parsed.scheme not in ('http', 'https') or not parsed.hostname:
            return None
        host = parsed.hostname.lower()
        if ':' in host:
            host = '[' + host + ']'
        port = parsed.port
        if port is not None and port != (443 if parsed.scheme == 'https' else 80):
            host += ':' + str(port)
        canonical = parsed.scheme.lower() + '://' + host + (parsed.path or '/')
        if parsed.query:
            canonical += '?' + parsed.query
        return hashlib.sha256(canonical.encode()).hexdigest()

    def add(self, method, **fields):
        if not self.enabled:
            return
        if len(self.events) >= 160:
            self.incomplete = True
            return
        self.events.append({'at': self.now(), 'method': method, **fields})

    def reply(self, method, params, result, session):
        if not self.enabled:
            return
        if method == 'Target.attachToTarget':
            target, sid = params.get('targetId'), result.get('sessionId')
            if self.valid_id(target) and self.valid_id(sid):
                self.sessions[sid] = target
                self.add(method, targetId=target, sessionId=sid)
        elif method == 'Security.setIgnoreCertificateErrors' and isinstance(params.get('ignore'), bool):
            self.add(method, ignore=params['ignore'], acknowledged=True)

    def selected(self, session, target):
        if not self.enabled:
            return
        if not self.valid_id(session) or not self.valid_id(target) or self.sessions.get(session) != target:
            self.incomplete = True
            return
        self.session, self.target = session, target
        self.add('helper.selected', sessionId=session, targetId=target)

    def event(self, message):
        if not self.enabled:
            return
        method, params = message.get('method'), message.get('params')
        if not isinstance(params, dict):
            return
        sid = message.get('sessionId')
        if method == 'Target.detachedFromTarget':
            sid = params.get('sessionId')
        if not self.valid_id(sid) or sid not in self.sessions:
            return
        target = self.sessions[sid]
        if method in ('Inspector.detached', 'Target.detachedFromTarget'):
            self.add(method, sessionId=sid, targetId=target)
            return
        rid = params.get('requestId')
        if not self.valid_id(rid):
            return
        key = (sid, rid)
        if method == 'Network.requestWillBeSent':
            request = params.get('request')
            if not isinstance(request, dict):
                return
            # XHR/fetch mutations must remain visible alongside document loads.
            if params.get('type') != 'Document' and request.get('method') != 'POST':
                return
            fingerprint = self.url_fingerprint(request.get('url', ''))
            verb = request.get('method')
            if fingerprint and verb in ('GET', 'POST', 'HEAD'):
                if len(self.requests) >= 80:
                    self.incomplete = True
                    return
                self.requests[key] = (fingerprint, verb)
                self.add(method, sessionId=sid, targetId=target, requestId=rid,
                         urlSha256=fingerprint, requestMethod=verb)
        elif key in self.requests:
            fingerprint, verb = self.requests[key]
            fields = dict(sessionId=sid, targetId=target, requestId=rid,
                          urlSha256=fingerprint, requestMethod=verb)
            if method == 'Network.responseReceived':
                response = params.get('response')
                status = response.get('status') if isinstance(response, dict) else None
                if isinstance(status, (int, float)) and not isinstance(status, bool) and 100 <= status <= 599:
                    self.add(method, status=int(status), **fields)
            elif method == 'Network.loadingFailed':
                error = params.get('errorText')
                allowed = ('net::ERR_CERT_AUTHORITY_INVALID', 'net::ERR_CERT_DATE_INVALID',
                    'net::ERR_NAME_NOT_RESOLVED', 'net::ERR_NAME_RESOLUTION_FAILED',
                    'net::ERR_CERT_COMMON_NAME_INVALID', 'net::ERR_CONNECTION_CLOSED',
                    'net::ERR_CONNECTION_RESET', 'net::ERR_CONNECTION_ABORTED',
                    'net::ERR_TIMED_OUT', 'net::ERR_EMPTY_RESPONSE', 'net::ERR_INTERNET_DISCONNECTED',
                    'net::ERR_ABORTED')
                self.add(method, errorCode=error if error in allowed else 'OTHER', **fields)

    def transport_failed(self, session):
        # One websocket owns all these sessions, including browser-level RPCs.
        selected = self.session
        if selected in self.sessions:
            self.add('transport.closed', sessionId=selected, targetId=self.sessions[selected])
        else:
            self.incomplete = True

    def finish(self, result):
        if not self.enabled:
            return None
        ok = isinstance(result, dict) and result.get('ok') is True and not result.get('error')
        if (self.command == 'snapshot' and (not isinstance(result, dict) or result.get('targetId') != self.target)) or (
            isinstance(result, dict) and result.get('targetId') is not None and result['targetId'] != self.target):
            self.incomplete = True
        if self.session and self.target:
            self.add('helper.result', sessionId=self.session, targetId=self.target, ok=bool(ok))
        else:
            self.incomplete = True
        return {'version': 1, 'runId': self.run_id, 'executionId': self.execution_id,
                'command': self.command, 'startedAt': self.started_at, 'completedAt': self.now(),
                'complete': not self.incomplete, 'events': self.events}


def evidence_call(client, method, *args):
    evidence = getattr(client, '_evidence', None)
    if evidence is not None:
        try:
            getattr(evidence, method)(*args)
        except Exception:
            # Instrumentation must not alter tool behavior; incomplete evidence cannot qualify.
            evidence.incomplete = True


def print_browser_result(result, evidence):
    if evidence is not None:
        try:
            envelope = evidence.finish(result)
            if envelope is not None:
                result = {**result, '_browserEvidence': envelope}
        except Exception:
            result = {**result, '_browserEvidence': {'version': 1, 'complete': False}}
    print(json.dumps(result))


class CdpClient:
    def __init__(self, ws_url: str, *, state_file: str | None = None) -> None:
        self._evidence = None
        self._ws_url = ws_url
        self._state_file = state_file
        self._sock: socket.socket | None = None
        self._buf = bytearray()
        self._next_id = 1
        self.context_id: int | None = None
        self._pending: dict[int, dict[str, Any] | None] = {}
        # Worlds live in Chromium until navigation; rediscover them per CLI process.
        self._contexts: dict[int, dict[str, Any]] = {}
        self._document_requests: dict[tuple[str, str], dict[str, Any]] = {}
        self._document_responses: dict[str, list[dict[str, Any]]] = {}
        self._document_failures: dict[str, list[dict[str, Any]]] = {}
        self._api_responses: dict[str, list[dict[str, Any]]] = {}
        self._harvested_apis: list[dict[str, Any]] = []
        self._downloads: dict[str, dict[str, Any]] = {}
        self._download_seq: int = 0
        self._active_target_id: str | None = None
        self._active_browser_context_id: str | None = None
        self._active_frame_id: str | None = None
        self._active_frame_ids: set[str] = set()
        self._active_download_dir: str | None = None
        self._session_targets: dict[str, dict[str, str]] = {}
        self._opener_map: dict[str, str] = {}
        self._target_generations: dict[str, int] = {}
        self._target_history: list[dict[str, Any]] = []
        self._stale_ref_rejections: list[dict[str, Any]] = []
        self._session_to_target: dict[str, str] = {}
        if self._state_file:
            self.load_persisted_state()

    def load_persisted_state(self) -> None:
        if not self._state_file or not os.path.isfile(self._state_file):
            return
        try:
            with open(self._state_file, "r", encoding="utf-8") as fh:
                data = json.load(fh)
            if not isinstance(data, dict):
                return
            # Cua-inspired generation boundary: a reused port is not browser identity.
            # Unknown/legacy state must be observed afresh, never attributed to this browser.
            if data.get("browserEndpoint") != self._ws_url:
                return
            seq = data.get("downloadSeq")
            if isinstance(seq, int) and not isinstance(seq, bool) and seq > self._download_seq:
                self._download_seq = seq
            downloads = data.get("downloads")
            if isinstance(downloads, dict):
                for guid, info in downloads.items():
                    if isinstance(guid, str) and guid and isinstance(info, dict):
                        self._downloads[guid] = dict(info)
                        for seq_key in ("seq", "updatedSeq"):
                            entry_seq = info.get(seq_key)
                            if (
                                isinstance(entry_seq, int)
                                and not isinstance(entry_seq, bool)
                                and entry_seq > self._download_seq
                            ):
                                self._download_seq = entry_seq
            apis = data.get("harvestedApis")
            if isinstance(apis, list):
                self._harvested_apis = [dict(a) for a in apis[-50:] if isinstance(a, dict)]
            active_tid = data.get("activeTargetId")
            if isinstance(active_tid, str) and active_tid:
                self._active_target_id = active_tid
            opener_map = data.get("openerMap")
            if isinstance(opener_map, dict):
                self._opener_map = {
                    str(k): str(v)
                    for k, v in opener_map.items()
                    if isinstance(k, str) and k and isinstance(v, str) and v
                }
            target_gens = data.get("targetGenerations")
            if isinstance(target_gens, dict):
                self._target_generations = {
                    str(k): int(v)
                    for k, v in target_gens.items()
                    if isinstance(k, str) and k and isinstance(v, int)
                }
            history = data.get("targetHistory")
            if isinstance(history, list):
                self._target_history = [dict(h) for h in history[-100:] if isinstance(h, dict)]
            rejections = data.get("staleRefRejections")
            if isinstance(rejections, list):
                self._stale_ref_rejections = [dict(r) for r in rejections[-50:] if isinstance(r, dict)]
        except Exception:
            pass

    def save_persisted_state(self) -> None:
        if not self._state_file:
            return
        try:
            parent = os.path.dirname(self._state_file)
            if parent:
                os.makedirs(parent, exist_ok=True)
            tmp_path = f"{self._state_file}.{os.getpid()}.tmp"
            payload = {
                "browserEndpoint": self._ws_url,
                "downloadSeq": self._download_seq,
                "downloads": self._downloads,
                "harvestedApis": self._harvested_apis[-50:],
                "activeTargetId": self._active_target_id,
                "openerMap": self._opener_map,
                "targetGenerations": self._target_generations,
                "targetHistory": self._target_history[-100:],
                "staleRefRejections": self._stale_ref_rejections[-50:],
            }
            with open(tmp_path, "w", encoding="utf-8") as fh:
                json.dump(payload, fh, ensure_ascii=False)
            os.replace(tmp_path, self._state_file)
        except Exception:
            pass

    def connect(self) -> None:
        assert self._ws_url.startswith("ws://"), self._ws_url
        rest = self._ws_url[len("ws://") :]
        host_port, _, path = rest.partition("/")
        if ":" in host_port:
            host, port_s = host_port.split(":", 1)
            port = int(port_s)
        else:
            host, port = host_port, 80
        path = "/" + path
        sock = socket.create_connection((host, port), timeout=10)
        key = base64.b64encode(os.urandom(16)).decode("ascii")
        req = (
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host_port}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "\r\n"
        )
        sock.sendall(req.encode("ascii"))
        data = b""
        while b"\r\n\r\n" not in data:
            chunk = sock.recv(4096)
            if not chunk:
                raise RuntimeError("CDP websocket handshake closed")
            data += chunk
            if len(data) > 16_384:
                raise RuntimeError("CDP handshake too large")
        header, _, leftover = data.partition(b"\r\n\r\n")
        if b"101" not in header.split(b"\r\n", 1)[0]:
            raise RuntimeError(f"CDP websocket upgrade failed: {header[:200]!r}")
        expected = base64.b64encode(
            hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode("ascii")).digest()
        )
        if expected not in header:
            raise RuntimeError("CDP websocket accept mismatch")
        self._sock = sock
        self._buf.extend(leftover)

    def close(self) -> None:
        if self._sock is not None:
            try:
                self._sock.close()
            except OSError:
                pass
            self._sock = None

    def _send_frame(self, payload: bytes) -> None:
        assert self._sock is not None
        mask = os.urandom(4)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        header = bytearray([0x81])
        n = len(payload)
        if n < 126:
            header.append(0x80 | n)
        elif n < 65536:
            header.append(0x80 | 126)
            header.extend(struct.pack("!H", n))
        else:
            header.append(0x80 | 127)
            header.extend(struct.pack("!Q", n))
        header.extend(mask)
        self._sock.sendall(header + masked)

    def _send_control(self, opcode: int, payload: bytes) -> None:
        assert self._sock is not None
        mask = os.urandom(4)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        header = bytearray([0x80 | opcode, 0x80 | len(payload)])
        header.extend(mask)
        self._sock.sendall(header + masked)

    def _read_more(self) -> None:
        assert self._sock is not None
        chunk = self._sock.recv(65536)
        if not chunk:
            raise RuntimeError("CDP websocket closed")
        self._buf.extend(chunk)

    def _read_frame(self) -> bytes:
        assert self._sock is not None
        while True:
            while len(self._buf) < 2:
                chunk = self._sock.recv(65536)
                if not chunk:
                    raise RuntimeError("CDP websocket closed")
                self._buf.extend(chunk)
            b1, b2 = self._buf[0], self._buf[1]
            opcode = b1 & 0x0F
            masked = bool(b2 & 0x80)
            length = b2 & 0x7F
            offset = 2
            if length == 126:
                while len(self._buf) < 4:
                    self._read_more()
                length = struct.unpack("!H", self._buf[2:4])[0]
                offset = 4
            elif length == 127:
                while len(self._buf) < 10:
                    self._read_more()
                length = struct.unpack("!Q", self._buf[2:10])[0]
                offset = 10
            if length > 2 * 1024 * 1024:
                raise RuntimeError("CDP frame too large")
            if not (b1 & 0x80):
                raise RuntimeError("Fragmented CDP message unsupported")
            mask = b""
            if masked:
                while len(self._buf) < offset + 4:
                    self._read_more()
                mask = bytes(self._buf[offset : offset + 4])
                offset += 4
            while len(self._buf) < offset + length:
                chunk = self._sock.recv(65536)
                if not chunk:
                    raise RuntimeError("CDP websocket closed while reading frame")
                self._buf.extend(chunk)
            payload = bytes(self._buf[offset : offset + length])
            del self._buf[: offset + length]
            if masked:
                payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
            if opcode == 0x8:
                raise RuntimeError("CDP websocket closed by peer")
            if opcode == 0x9:
                self._send_control(0xA, payload)
                continue
            if opcode in (0x1, 0x2, 0x0):
                return payload

    def _handle_event(self, message: dict[str, Any]) -> None:
        evidence_call(self, "event", message)
        method = message.get("method")
        params = message.get("params") or {}
        session_id = message.get("sessionId")
        sid = str(session_id or "")
        if method == "Runtime.executionContextCreated":
            context = params.get("context")
            if not isinstance(context, dict):
                return
            context_id = context.get("id")
            if not isinstance(context_id, int):
                return
            recorded = dict(context)
            recorded["_sessionId"] = session_id
            self._contexts[context_id] = recorded
        elif method == "Runtime.executionContextDestroyed":
            context_id = params.get("executionContextId")
            if isinstance(context_id, int):
                self._contexts.pop(context_id, None)
        elif method == "Runtime.executionContextsCleared":
            if session_id is None:
                self._contexts.clear()
            else:
                self._contexts = {
                    cid: ctx
                    for cid, ctx in self._contexts.items()
                    if ctx.get("_sessionId") != session_id
                }
        elif method == "Network.requestWillBeSent":
            req_id = str(params.get("requestId") or "")
            if not req_id:
                return
            is_doc = params.get("type") == "Document" or (sid, req_id) in self._document_requests
            if not is_doc:
                return
            req_obj = params.get("request") or {}
            req_url = str(req_obj.get("url") or "") if isinstance(req_obj, dict) else ""
            entry = self._document_requests.setdefault(
                (sid, req_id),
                {
                    "requestId": req_id,
                    "loaderId": params.get("loaderId"),
                    "frameId": params.get("frameId"),
                    "url": req_url,
                    "redirectChain": [],
                },
            )
            if params.get("loaderId"):
                entry["loaderId"] = params.get("loaderId")
            if params.get("frameId"):
                entry["frameId"] = params.get("frameId")
            redirect_resp = params.get("redirectResponse")
            if isinstance(redirect_resp, dict):
                redir_status = redirect_resp.get("status")
                entry["redirectChain"].append(
                    {
                        "url": str(redirect_resp.get("url") or entry.get("url") or ""),
                        "status": int(redir_status)
                        if isinstance(redir_status, int) and not isinstance(redir_status, bool)
                        else 0,
                    }
                )
            if req_url:
                entry["url"] = req_url
        elif method == "Network.responseReceived":
            res_type = params.get("type")
            req_id = str(params.get("requestId") or "")
            response = params.get("response") or {}
            if not isinstance(response, dict):
                return
            raw_status = response.get("status")
            status_val = (
                int(raw_status)
                if isinstance(raw_status, int) and not isinstance(raw_status, bool) and raw_status > 0
                else None
            )
            if res_type in ("XHR", "Fetch"):
                mime = str(response.get("mimeType") or "").lower()
                resp_url = str(response.get("url") or "")
                if "json" in mime or resp_url.endswith(".json") or "/api/" in resp_url or "/_api/" in resp_url or "graph.microsoft.com" in resp_url:
                    self._api_responses.setdefault(sid, []).append(
                        {
                            "requestId": req_id,
                            "url": resp_url,
                            "status": status_val,
                            "mimeType": mime,
                        }
                    )
                return
            if res_type != "Document":
                return
            req_entry = self._document_requests.get((sid, req_id)) or {}
            headers = response.get("headers") if isinstance(response.get("headers"), dict) else {}
            self._document_responses.setdefault(sid, []).append(
                {
                    "requestId": req_id,
                    "loaderId": params.get("loaderId") or req_entry.get("loaderId"),
                    "frameId": params.get("frameId") or req_entry.get("frameId"),
                    "url": str(response.get("url") or req_entry.get("url") or ""),
                    "status": status_val,
                    "headers": headers,
                    "redirectChain": list(req_entry.get("redirectChain") or []),
                }
            )
        elif method == "Browser.downloadWillBegin":
            guid = str(params.get("guid") or "").strip()
            if guid:
                self._download_seq += 1
                session_meta = self._session_targets.get(sid) or {}
                frame_id = str(
                    params.get("frameId")
                    or session_meta.get("frameId")
                    or self._active_frame_id
                    or ""
                )
                target_id = str(
                    params.get("targetId")
                    or session_meta.get("targetId")
                    or self._active_target_id
                    or ""
                )
                browser_context_id = str(
                    params.get("browserContextId")
                    or session_meta.get("browserContextId")
                    or self._active_browser_context_id
                    or ""
                )
                download_dir = str(
                    params.get("downloadDir")
                    or self._active_download_dir
                    or os.environ.get("RAKAZO_DOWNLOAD_DIR")
                    or ""
                )
                entry: dict[str, Any] = {
                    "guid": guid,
                    "url": str(params.get("url") or ""),
                    "suggestedFilename": str(params.get("suggestedFilename") or "download"),
                    "state": "inProgress",
                    "seq": self._download_seq,
                    "updatedSeq": self._download_seq,
                }
                if frame_id:
                    entry["frameId"] = frame_id
                if target_id:
                    entry["targetId"] = target_id
                if browser_context_id:
                    entry["browserContextId"] = browser_context_id
                if download_dir:
                    entry["downloadDir"] = download_dir
                self._downloads[guid] = entry
                self.save_persisted_state()
        elif method == "Browser.downloadProgress":
            guid = str(params.get("guid") or "").strip()
            if guid:
                self._download_seq += 1
                entry = self._downloads.setdefault(
                    guid,
                    {"guid": guid, "seq": self._download_seq},
                )
                entry["updatedSeq"] = self._download_seq
                entry["state"] = str(params.get("state") or entry.get("state") or "inProgress")
                if isinstance(params.get("receivedBytes"), int) and not isinstance(
                    params.get("receivedBytes"), bool
                ):
                    entry["receivedBytes"] = int(params["receivedBytes"])
                if isinstance(params.get("totalBytes"), int) and not isinstance(
                    params.get("totalBytes"), bool
                ):
                    entry["totalBytes"] = int(params["totalBytes"])
                if params.get("filePath"):
                    entry["filePath"] = str(params["filePath"])
                session_meta = self._session_targets.get(sid) or {}
                for meta_key, fallback_val in (
                    (
                        "frameId",
                        params.get("frameId")
                        or session_meta.get("frameId")
                        or self._active_frame_id,
                    ),
                    (
                        "targetId",
                        params.get("targetId")
                        or session_meta.get("targetId")
                        or self._active_target_id,
                    ),
                    (
                        "browserContextId",
                        params.get("browserContextId")
                        or session_meta.get("browserContextId")
                        or self._active_browser_context_id,
                    ),
                    (
                        "downloadDir",
                        params.get("downloadDir")
                        or self._active_download_dir
                        or os.environ.get("RAKAZO_DOWNLOAD_DIR"),
                    ),
                ):
                    if not entry.get(meta_key) and isinstance(fallback_val, str) and fallback_val:
                        entry[meta_key] = fallback_val
                self.save_persisted_state()
        elif method == "Network.loadingFailed":
            req_id = str(params.get("requestId") or "")
            req_entry = self._document_requests.get((sid, req_id))
            if params.get("type") != "Document" and req_entry is None:
                return
            self._document_failures.setdefault(sid, []).append(
                {
                    "requestId": req_id,
                    "loaderId": params.get("loaderId") or (req_entry or {}).get("loaderId"),
                    "frameId": params.get("frameId") or (req_entry or {}).get("frameId"),
                    "errorText": str(params.get("errorText") or "Network loading failed"),
                    "canceled": bool(params.get("canceled")),
                }
            )

    def find_world_context(self, world_name: str, frame_id: str, session_id: str) -> int | None:
        for context_id, context in self._contexts.items():
            if context.get("name") != world_name:
                continue
            if context.get("_sessionId") != session_id:
                continue
            aux = context.get("auxData") or {}
            if not isinstance(aux, dict) or aux.get("frameId") != frame_id or aux.get("isDefault") is not False:
                continue
            return context_id
        return None

    def call(
        self,
        method: str,
        params: dict[str, Any] | None = None,
        *,
        session_id: str | None = None,
        timeout_s: float = 30.0,
    ) -> dict[str, Any]:
        assert self._sock is not None
        msg_id = self._next_id
        self._next_id += 1
        payload: dict[str, Any] = {"id": msg_id, "method": method, "params": params or {}}
        if session_id:
            payload["sessionId"] = session_id
        self._pending[msg_id] = None
        try:
            self._send_frame(json.dumps(payload).encode("utf-8"))
        except (ConnectionError, OSError):
            evidence_call(self, "transport_failed", session_id)
            raise
        deadline = time.time() + timeout_s
        while time.time() < deadline:
            pending = self._pending.get(msg_id)
            if pending is not None:
                self._pending.pop(msg_id, None)
                if "error" in pending:
                    raise RuntimeError(f"{method} failed: {pending['error']}")
                result = pending.get("result")
                result = result if isinstance(result, dict) else {}
                evidence_call(self, "reply", method, params or {}, result, session_id)
                return result
            self._sock.settimeout(max(0.1, deadline - time.time()))
            try:
                frame = self._read_frame()
            except socket.timeout:
                continue
            except (ConnectionError, OSError, RuntimeError) as exc:
                if isinstance(exc, (ConnectionError, OSError)) or "websocket closed" in str(exc):
                    evidence_call(self, "transport_failed", session_id)
                raise
            message = json.loads(frame.decode("utf-8"))
            if not isinstance(message, dict):
                continue
            if message.get("id") in self._pending:
                self._pending[int(message["id"])] = message
                continue
            if message.get("method"):
                self._handle_event(message)
        raise TimeoutError(f"CDP call timed out: {method}")


CLOSED_SHADOW_INIT_SCRIPT = r"""
(() => {
  if (window.__rakazoClosedShadows) return;
  window.__rakazoClosedShadows = new WeakSet();
  const orig = Element.prototype.attachShadow;
  if (orig) {
    Element.prototype.attachShadow = function(init) {
      if (init && init.mode === "closed") {
        window.__rakazoClosedShadows.add(this);
        try { this.setAttribute("data-rakazo-closed-shadow", "1"); } catch {}
      }
      return orig.call(this, init);
