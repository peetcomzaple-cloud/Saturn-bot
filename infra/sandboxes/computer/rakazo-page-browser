  function extractPageText(frameTexts, shadowTexts = []) {
    const raw = (document.body?.innerText || document.body?.textContent || "");
    const shadowPart = shadowTexts.length ? "\n" + shadowTexts.join("\n").slice(0, 2000) : "";
    const framePart = frameTexts.length ? "\n" + frameTexts.join("\n").slice(0, 4000) : "";
