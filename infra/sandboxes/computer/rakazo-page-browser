      if (el instanceof InputCtor || el instanceof TextAreaCtor || el instanceof SelectCtor) {
        if (el instanceof InputCtor && !["text", "search", "email", "url", "tel", "password", "number"].includes(el.type)) {
          throw new Error("Input type requires desktop tools");
        }
        const prototype = el instanceof InputCtor ? InputCtor.prototype
          : el instanceof TextAreaCtor ? TextAreaCtor.prototype : SelectCtor.prototype;
        Object.getOwnPropertyDescriptor(prototype, "value").set.call(el, String(value));
