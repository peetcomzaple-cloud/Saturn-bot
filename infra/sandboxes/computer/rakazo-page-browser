"""


def eval_json(client: CdpClient, session_id: str, expression: str) -> Any:
    result = client.call(
        "Runtime.evaluate",
        {
            "expression": expression,
            "contextId": client.context_id,
            "returnByValue": True,
            "awaitPromise": True,
            "userGesture": True,
        },
        session_id=session_id,
    )
    if result.get("exceptionDetails"):
        details = result["exceptionDetails"]
        raw_text = str(details.get("text") or "").strip()
        desc = str((details.get("exception") or {}).get("description") or "").strip()
        text = (
            desc
            if (not raw_text or raw_text.lower().startswith("uncaught")) and desc
            else (raw_text or desc or "evaluate failed")
        )
        raise RuntimeError(str(text))
    return (result.get("result") or {}).get("value")


def ensure_helpers(client: CdpClient, session_id: str) -> None:
    ensure_world(client, session_id)
    eval_json(client, session_id, EVAL_HELPERS)


def parse_retry_after_ms(headers: dict[str, Any] | None) -> int | None:
    if not isinstance(headers, dict):
        return None
    raw_val = None
    for k, v in headers.items():
        if isinstance(k, str) and k.lower() == "retry-after":
            raw_val = v
            break
    if raw_val is None:
        return None
    text = str(raw_val).strip()
    if not text:
        return None
    try:
        seconds = int(text)
        if seconds >= 0:
            return min(seconds * 1000, 300_000)
    except ValueError:
        pass
    return None


def find_document_response(
    client: Any,
    session_id: str,
    loader_id: str | None,
    frame_id: str | None,
) -> dict[str, Any] | None:
    store = getattr(client, "_document_responses", None)
    if not isinstance(store, dict):
        return None
    entries = store.get(str(session_id or "")) or store.get("") or []
    if not isinstance(entries, list):
        return None
    if loader_id:
        for entry in reversed(entries):
            if isinstance(entry, dict) and entry.get("loaderId") == loader_id:
                return entry
    if frame_id:
        for entry in reversed(entries):
            if isinstance(entry, dict) and entry.get("frameId") == frame_id:
                return entry
    return None


def find_document_failure(
    client: Any,
    session_id: str,
    loader_id: str | None,
    frame_id: str | None,
) -> dict[str, Any] | None:
    store = getattr(client, "_document_failures", None)
    if not isinstance(store, dict):
        return None
    entries = store.get(str(session_id or "")) or store.get("") or []
    if not isinstance(entries, list):
        return None
    if loader_id:
        for entry in reversed(entries):
            if isinstance(entry, dict) and entry.get("loaderId") == loader_id:
                return entry
    if frame_id:
        for entry in reversed(entries):
            if isinstance(entry, dict) and entry.get("frameId") == frame_id:
                return entry
    return None


def normalize_url_for_redirect(raw_url: str) -> str:
    try:
        sp = urlsplit(raw_url)
        path = sp.path or "/"
        return f"{sp.scheme.lower()}://{sp.netloc.lower()}{path}{('?' + sp.query) if sp.query else ''}"
    except Exception:
        return raw_url


def detect_challenge_page(
    title: str,
    body_snippet: str,
    has_challenge_dom: bool,
    http_status: int | None,
) -> str | None:
    if has_challenge_dom:
        return "bot_challenge"
    combined = f"{title}\n{body_snippet}".lower()
    cloudflare_markers = (
        "just a moment...",
        "attention required! | cloudflare",
        "checking your browser before accessing",
        "verify you are human",
        "cf-chl-bypass",
        "enable javascript and cookies to continue",
    )
    if any(marker in combined for marker in cloudflare_markers):
        return "cloudflare_challenge"
    captcha_markers = (
        "please complete the security check",
        "unusual traffic from your computer network",
        "กรุณายืนยันว่าคุณไม่ใช่บอท",
    )
    if any(marker in combined for marker in captcha_markers):
        return "captcha_challenge"
    if http_status in (403, 429, 503) and (
        "cloudflare" in combined or "captcha" in combined or "security check" in combined
    ):
        return "bot_challenge"
    return None


def navigate(client: CdpClient, session_id: str, url: str) -> dict[str, Any]:
    parsed = urlsplit(url)
    if parsed.scheme not in ("http", "https") or parsed.username or parsed.password:
        raise RuntimeError("Only HTTP(S) URLs without embedded credentials are supported")
    result = client.call("Page.navigate", {"url": url}, session_id=session_id, timeout_s=15.0)
    if result.get("errorText") or result.get("isDownload"):
        raise RuntimeError(result.get("errorText") or "Navigation started a download")
    deadline = time.monotonic() + 10.0
    while time.monotonic() < deadline:
        doc_failure = find_document_failure(
            client, session_id, result.get("loaderId"), result.get("frameId")
        )
        if doc_failure is not None:
            raise RuntimeError(str(doc_failure.get("errorText") or "Navigation failed"))
        try:
            frame = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]
            if result.get("loaderId") and frame.get("loaderId") != result["loaderId"]:
                time.sleep(0.1)
                continue
            ensure_world(client, session_id)
            ready = eval_json(client, session_id, "document.readyState")
            if ready in ("interactive", "complete"):
                page_info = eval_json(
                    client,
                    session_id,
                    """(() => {
                        let status = null;
                        let redirected = false;
                        try {
                            const nav = performance.getEntriesByType('navigation')[0];
                            if (nav) {
                                if (typeof nav.responseStatus === 'number' && Number.isInteger(nav.responseStatus) && nav.responseStatus > 0) {
                                    status = nav.responseStatus;
                                }
                                if (typeof nav.redirectCount === 'number' && nav.redirectCount > 0) {
                                    redirected = true;
                                }
                            }
                        } catch (e) {}
                        const bodyText = (document.body && document.body.innerText ? document.body.innerText : '').slice(0, 1000);
                        const hasChallengeDom = Boolean(
                            document.querySelector &&
                            document.querySelector(
                                '#challenge-running, #challenge-form, #cf-challenge-running, [name="cf-turnstile-response"], iframe[src*="challenges.cloudflare.com"], iframe[src*="recaptcha"], iframe[src*="hcaptcha"], .g-recaptcha, .h-captcha'
                            )
                        );
                        return {
                            url: location.href,
                            title: (document.title || '').slice(0, 200),
                            httpStatus: status,
                            redirected,
                            bodySnippet: bodyText,
                            hasChallengeDom
                        };
                    })()""",
                )
                if not isinstance(page_info, dict):
                    page_info = {
                        "url": eval_json(client, session_id, "location.href"),
                        "title": eval_json(client, session_id, "(document.title || '').slice(0, 200)"),
                        "httpStatus": None,
                    }
                loader_id = result.get("loaderId")
                frame_id = frame.get("id")
                doc_resp = find_document_response(client, session_id, loader_id, frame_id)
                cdp_status = doc_resp.get("status") if isinstance(doc_resp, dict) else None
                perf_status = page_info.get("httpStatus")
                if isinstance(cdp_status, int) and not isinstance(cdp_status, bool) and cdp_status > 0:
                    status_code: int | None = cdp_status
                elif isinstance(perf_status, int) and not isinstance(perf_status, bool) and perf_status > 0:
                    status_code = perf_status
                else:
                    status_code = None

                http_status_status = "known" if status_code is not None else "unknown"
                page_url = str(page_info.get("url") or (doc_resp or {}).get("url") or "")
                page_title = str(page_info.get("title") or "")
                redirect_chain = (
                    list(doc_resp.get("redirectChain") or [])
                    if isinstance(doc_resp, dict) and isinstance(doc_resp.get("redirectChain"), list)
                    else []
                )
                redirected = (
                    bool(redirect_chain)
                    or bool(page_info.get("redirected"))
                    or (
                        bool(page_url)
                        and normalize_url_for_redirect(page_url) != normalize_url_for_redirect(url)
                    )
                )
                retry_after_ms = (
                    parse_retry_after_ms(doc_resp.get("headers"))
                    if isinstance(doc_resp, dict)
                    else None
                )
                challenge_type = detect_challenge_page(
                    page_title,
                    str(page_info.get("bodySnippet") or ""),
                    bool(page_info.get("hasChallengeDom")),
                    status_code,
                )
                extra_fields: dict[str, Any] = {
                    "httpStatusStatus": http_status_status,
                }
                if status_code is not None:
                    extra_fields["httpStatus"] = status_code
                if redirected:
                    extra_fields["redirected"] = True
                if redirect_chain:
                    extra_fields["redirectChain"] = redirect_chain
                if retry_after_ms is not None:
                    extra_fields["retryAfterMs"] = retry_after_ms
                if challenge_type is not None:
                    extra_fields["challengeDetected"] = True
                    extra_fields["challengeType"] = challenge_type

                if status_code is not None and status_code >= 400:
                    return {
                        "ok": False,
                        **extra_fields,
                        "url": page_url,
                        "title": page_title,
                        "loaderId": loader_id,
                        "frameId": frame_id,
                        "error": f"HTTP {status_code} error: {page_title or 'Bad Response'}",
                        "fallback": "computer_act",
                    }
                if challenge_type is not None:
                    return {
                        "ok": False,
                        **extra_fields,
                        "url": page_url,
                        "title": page_title,
                        "loaderId": loader_id,
                        "frameId": frame_id,
                        "error": f"Anti-bot or security challenge detected ({challenge_type}): {page_title or page_url}",
                        "fallback": "computer_act",
                    }
                if isinstance(client, CdpClient) and not str(page_info.get("bodySnippet") or "").strip():
                    spa_deadline = time.monotonic() + 1.2
                    while time.monotonic() < spa_deadline:
                        try:
                            ensure_world(client, session_id)
                            text_len = eval_json(
                                client,
                                session_id,
                                "(document.body && document.body.innerText ? document.body.innerText.trim().length : 0)",
                            )
                            if isinstance(text_len, int) and text_len > 0:
                                break
                        except Exception:
                            pass
                        time.sleep(0.15)
                return {
                    "ok": True,
                    **extra_fields,
                    "url": page_url,
                    "title": page_title,
                    "loaderId": loader_id,
                    "frameId": frame_id,
                }
        except Exception:
            pass
        time.sleep(0.1)
    raise RuntimeError("Navigation did not settle; inspect the screen before continuing")


DEFAULT_CLEAR_STORAGE_TYPES = (
    "cookies",
    "local_storage",
    "indexeddb",
    "cache_storage",
    "service_workers",
)
ALLOWED_CLEAR_STORAGE_TYPES = frozenset(DEFAULT_CLEAR_STORAGE_TYPES)


def normalize_http_origin(raw_origin: Any) -> tuple[str, str, str]:
    if not isinstance(raw_origin, str) or not raw_origin.strip():
        raise ValueError("origin must be a non-empty HTTP(S) origin")
    parsed = urlsplit(raw_origin.strip())
    scheme = parsed.scheme.lower()
    if scheme not in ("http", "https") or not parsed.hostname:
        raise ValueError("origin must use http or https and include a hostname")
    if parsed.username or parsed.password:
        raise ValueError("origin must not contain credentials")
    if parsed.path not in ("", "/") or parsed.query or parsed.fragment:
        raise ValueError("origin must not contain a path, query, or fragment")
    hostname = parsed.hostname.lower()
    port = parsed.port
    host_display = f"[{hostname}]" if ":" in hostname else hostname
    if port is not None and not ((scheme == "http" and port == 80) or (scheme == "https" and port == 443)):
        netloc = f"{host_display}:{port}"
    else:
        netloc = host_display
    return f"{scheme}://{netloc}", scheme, hostname


def clear_origin_storage(
    client: CdpClient,
    session_id: str,
    args: dict[str, Any],
) -> dict[str, Any]:
    if not isinstance(args, dict):
        raise ValueError("args must be an object")
    origin, _scheme, hostname = normalize_http_origin(args.get("origin"))
    raw_storage_key = args.get("storageKey")
    storage_key: str | None = None
    if raw_storage_key is not None:
        if not isinstance(raw_storage_key, str) or not raw_storage_key.strip():
            raise ValueError("storageKey must be a non-empty string when provided")
        candidate_key = raw_storage_key.strip()
        key_origin_part = candidate_key.split("^", 1)[0].rstrip("/")
        try:
            normalized_key_origin, _, _ = normalize_http_origin(key_origin_part)
        except ValueError as exc:
            raise ValueError("storageKey does not contain a valid HTTP(S) origin") from exc
        if normalized_key_origin != origin:
            raise ValueError(f"storageKey origin {normalized_key_origin} does not match target origin {origin}")
        storage_key = candidate_key

    raw_types = args.get("storageTypes")
    if raw_types is None:
        requested_types = list(DEFAULT_CLEAR_STORAGE_TYPES)
    else:
        if not isinstance(raw_types, list) or not raw_types:
            raise ValueError("storageTypes must be a non-empty array when provided")
        requested_types = []
        for item in raw_types:
            if not isinstance(item, str) or item not in ALLOWED_CLEAR_STORAGE_TYPES:
                raise ValueError(
                    f"Unsupported or unsafe storageType: {item!r}. Allowed: {sorted(ALLOWED_CLEAR_STORAGE_TYPES)}"
                )
            if item not in requested_types:
                requested_types.append(item)

    include_session_storage = bool(args.get("includeSessionStorage") is True)
    include_subdomain_shared = bool(args.get("includeSubdomainSharedCookies") is True)

    cdp_storage_types = [t for t in requested_types if t != "cookies"]
    if cdp_storage_types:
        joined_types = ",".join(cdp_storage_types)
        if storage_key:
            client.call(
                "Storage.clearDataForStorageKey",
                {"storageKey": storage_key, "storageTypes": joined_types},
                session_id=session_id,
            )
        else:
            client.call(
                "Storage.clearDataForOrigin",
                {"origin": origin, "storageTypes": joined_types},
                session_id=session_id,
            )

    deleted_cookies = 0
    if "cookies" in requested_types:
        cookies_res = client.call(
            "Network.getCookies",
            {"urls": [origin, f"{origin}/"]},
            session_id=session_id,
        )
        cookies = cookies_res.get("cookies") if isinstance(cookies_res, dict) else []
        if isinstance(cookies, list):
            for cookie in cookies:
                if not isinstance(cookie, dict):
                    continue
                cookie_name = cookie.get("name")
                raw_domain = str(cookie.get("domain") or "")
                if not isinstance(cookie_name, str) or not cookie_name or not raw_domain:
                    continue
                clean_domain = raw_domain.lstrip(".").lower()
                is_exact_host = clean_domain == hostname
                is_parent_shared = hostname.endswith("." + clean_domain)
                if is_exact_host or (include_subdomain_shared and is_parent_shared):
                    delete_params: dict[str, Any] = {
                        "name": cookie_name,
                        "domain": raw_domain,
                        "url": origin,
                    }
                    if isinstance(cookie.get("path"), str) and cookie["path"]:
                        delete_params["path"] = cookie["path"]
                    if cookie.get("partitionKey") is not None:
                        delete_params["partitionKey"] = cookie["partitionKey"]
                    client.call("Network.deleteCookies", delete_params, session_id=session_id)
                    deleted_cookies += 1

    if include_session_storage:
        frame = client.call("Page.getFrameTree", session_id=session_id).get("frameTree", {}).get("frame", {})
        frame_origin = None
        if isinstance(frame, dict):
            sec_origin = frame.get("securityOrigin")
            frame_url = frame.get("url")
            for candidate in (sec_origin, frame_url):
                if isinstance(candidate, str) and candidate.startswith(("http://", "https://")):
                    try:
                        sp = urlsplit(candidate)
                        if sp.hostname:
                            frame_origin, _, _ = normalize_http_origin(f"{sp.scheme}://{sp.netloc}")
                            break
                    except ValueError:
                        pass
        if frame_origin != origin:
            raise RuntimeError(
                f"Cannot clear sessionStorage for {origin} while active tab is at {frame_origin or 'another origin'}"
            )
        client.call("DOMStorage.enable", session_id=session_id)
        storage_id: dict[str, Any] = {
            "securityOrigin": origin,
            "isLocalStorage": False,
        }
        if storage_key:
            storage_id["storageKey"] = storage_key
        client.call("DOMStorage.clear", {"storageId": storage_id}, session_id=session_id)

    harvested = getattr(client, "_harvested_apis", None)
    if isinstance(harvested, list):
        client._harvested_apis = [
            item
            for item in harvested
            if not (
                isinstance(item, dict)
                and str(item.get("url") or "").lower().startswith(origin.lower())
            )
        ]
        if hasattr(client, "save_persisted_state"):
            client.save_persisted_state()

    return {
        "ok": True,
        "origin": origin,
        "clearedStorageTypes": requested_types,
        "clearedSessionStorage": include_session_storage,
        "includeSubdomainSharedCookies": include_subdomain_shared,
        "deletedCookies": deleted_cookies,
        **({"storageKey": storage_key} if storage_key else {}),
    }


def snapshot(client: CdpClient, session_id: str) -> dict[str, Any]:
    if isinstance(client, CdpClient):
        settle_deadline = time.monotonic() + 2.5
        while time.monotonic() < settle_deadline:
            try:
                ensure_world(client, session_id)
                state = eval_json(
                    client,
                    session_id,
                    """({
                        url: location.href,
                        ready: document.readyState,
                        textLen: (document.body && document.body.innerText ? document.body.innerText.trim().length : 0),
                        hasInput: Boolean(document.querySelector('input:not([type="hidden"]), textarea')),
                        hasLoadingOverlay: Boolean(
                            document.querySelector('ion-loading, [aria-busy="true"], [data-loading="true"]') ||
                            /signing in\\.\\.\\./i.test(document.body && document.body.innerText ? document.body.innerText : '') ||
                            (document.getElementById('spa-status') && /^(กำลังโหลด|loading\\.\\.\\.)/i.test((document.getElementById('spa-status').innerText || '').trim()))
                        )
                    })""",
                )
            except Exception:
                time.sleep(0.2)
                continue
            if not isinstance(state, dict):
                time.sleep(0.2)
                continue
            cur_url = str(state.get("url") or "")
            ready = str(state.get("ready") or "")
            text_len = int(state.get("textLen") or 0)
            has_input = bool(state.get("hasInput"))
            has_loading_overlay = bool(state.get("hasLoadingOverlay"))
            if (
                ready != "complete"
                or has_loading_overlay
                or any(token in cur_url for token in ("/__/auth/handler", "/o/oauth2/", "/ServiceLogin"))
                or ("accounts.google.com" in cur_url and not has_input)
                or (cur_url.startswith("http") and text_len == 0 and not has_input)
            ):
                time.sleep(0.2)
                continue
            break
    ensure_helpers(client, session_id)
    data = eval_json(client, session_id, "window.__rakazoPageBrowser.snapshot()")
    if not isinstance(data, dict):
        raise RuntimeError("snapshot returned non-object")
    session_to_target = getattr(client, "_session_to_target", None)
    target_id = (
        session_to_target.get(session_id)
        if isinstance(session_to_target, dict) and session_id in session_to_target
        else getattr(client, "_active_target_id", None)
    )
    opener_map = getattr(client, "_opener_map", None)
    opener_tid = (
        opener_map.get(target_id)
        if target_id and isinstance(opener_map, dict)
        else None
    )
    frame_id: str | None = None
    loader_id: str | None = None
    try:
        frame = client.call("Page.getFrameTree", session_id=session_id).get("frameTree", {}).get("frame", {})
        if isinstance(frame, dict) and frame.get("loaderId"):
            loader_id = str(frame["loaderId"])
        if isinstance(frame, dict) and frame.get("id"):
            frame_id = str(frame["id"])
    except Exception:
        pass
    doc_resp = find_document_response(client, session_id, None, frame_id)
    http_status = doc_resp.get("status") if isinstance(doc_resp, dict) else None
    target_gens = getattr(client, "_target_generations", None)
    if target_id and isinstance(target_gens, dict):
        prev_gen = int(target_gens.get(target_id, 0) or 0)
        snap_gen = max(prev_gen + 1, int(data.get("snapshotGeneration") or 1))
        target_gens[target_id] = snap_gen
        data["snapshotGeneration"] = snap_gen
    if target_id:
        data["targetId"] = target_id
        data["openerTargetId"] = opener_tid
    if frame_id:
        data["frameId"] = frame_id
    if loader_id:
        data["loaderId"] = loader_id
    # Selected document only; tab titles/accessibility text cannot establish JSON fields.
    try:
        body = eval_json(client, session_id, "(() => { const status=performance.getEntriesByType('navigation')[0]?.responseStatus; const isJson=/json/i.test(document.contentType); return {url:location.href,status,isJson,text:(isJson || status>=400) ? (document.body?.innerText || '').slice(0,16384) : ''}; })()")
        if isinstance(body, dict) and body.get("text") and body.get("url") == data.get("url"):
            after_frame = client.call("Page.getFrameTree", session_id=session_id).get("frameTree", {}).get("frame", {})
            if loader_id and after_frame.get("id") == frame_id and after_frame.get("loaderId") == loader_id:
                if body.get("isJson"):
                    data["responseBodyText"] = str(body["text"])
                if isinstance(body.get("status"), int) and not isinstance(body["status"], bool) and body["status"] >= 400:
                    data["errorDocumentText"] = str(body["text"])
                    data["errorDocumentStatus"] = body["status"]
    except Exception:
        pass  # Missing body evidence cannot qualify an API error report.
    if isinstance(http_status, int) and http_status > 0:
        data["httpStatus"] = http_status
    tabs = list_browser_tabs(client, active_session_id=session_id)
    if tabs:
        data["tabs"] = tabs
        if len(tabs) > 1 and isinstance(data.get("elements"), list):
            tab_lines = ["[Open Browser Tabs]:"]
            for t in tabs:
                tid = str(t.get("targetId") or "")
                is_active = bool(t.get("active"))
                t_title = str(t.get("title") or "")
                t_url = str(t.get("url") or "")
                t_opener = t.get("openerTargetId")
                opener_note = f" (opener={t_opener})" if t_opener else ""
                tab_lines.append(
                    f"  * [{'ACTIVE' if is_active else 'TAB'} {tid}]{opener_note} {t_title} — {t_url}"
                )
                if not is_active and tid:
                    switch_ref = f"tab_{tid}"
                    data["elements"].append(
                        {
                            "ref": switch_ref,
                            "role": "tab",
                            "name": f"Switch to tab: {t_title or t_url} ({t_url})",
                            "tag": "tab",
                            "targetId": tid,
                        }
                    )
                    data["tree"] = str(data.get("tree") or "") + f'\n- tab "Switch to tab: {t_title or t_url} ({t_url})" [{switch_ref}]'
            data["tree"] = "\n".join(tab_lines) + "\n\n" + str(data.get("tree") or "")
    record_target_observation(
        client,
        target_id,
        str(data.get("url") or ""),
        str(data.get("title") or ""),
        data.get("domGeneration") if isinstance(data.get("domGeneration"), int) else None,
        data.get("snapshotGeneration") if isinstance(data.get("snapshotGeneration"), int) else None,
    )
    return {"ok": True, **data}


def switch_to_target(client: Any, target_id: str) -> str:
    try:
        client.call("Target.activateTarget", {"targetId": target_id})
    except Exception:
        pass
    attached = client.call("Target.attachToTarget", {"targetId": target_id, "flatten": True})
    session_id = str(attached["sessionId"])
    try:
        client.call("Page.enable", session_id=session_id)
        client.call("Network.enable", session_id=session_id)
    except Exception:
        pass
    session_to_target = getattr(client, "_session_to_target", None)
    if isinstance(session_to_target, dict):
        session_to_target[session_id] = target_id
    client._active_target_id = target_id
    evidence_call(client, "selected", session_id, target_id)
    if hasattr(client, "save_persisted_state"):
        client.save_persisted_state()
    return session_id


def act(client: CdpClient, session_id: str, actions: list[dict[str, Any]]) -> dict[str, Any]:
    if not actions or len(actions) > 24:
        raise RuntimeError("Expected 1 to 24 actions")
    for step in actions:
        if not isinstance(step, dict) or step.get("kind") not in ("click", "fill", "type"):
            raise RuntimeError("Invalid browser action")
        if not isinstance(step.get("ref"), str) or not step["ref"]:
            raise RuntimeError("Element ref is required")
        if step["kind"] != "click" and not isinstance(step.get("text"), str):
            raise RuntimeError("Text is required")
        if step.get("origin") is not None and (
            step["kind"] != "fill" or not isinstance(step["origin"], str)
        ):
            raise RuntimeError("An origin applies only to fill")
    ensure_helpers(client, session_id)
    session_to_target = getattr(client, "_session_to_target", None)
    starting_tid = (
        session_to_target.get(session_id)
        if isinstance(session_to_target, dict) and session_id in session_to_target
        else getattr(client, "_active_target_id", None)
    )
    pre_download_seq = (
        client._download_seq
        if isinstance(getattr(client, "_download_seq", None), int)
        and not isinstance(getattr(client, "_download_seq", None), bool)
        else 0
    )
    pre_downloads_snapshot: dict[str, dict[str, Any]] = {}
    raw_pre_downloads = getattr(client, "_downloads", None)
    if isinstance(raw_pre_downloads, dict):
        for d_guid, d_info in raw_pre_downloads.items():
            if isinstance(d_guid, str) and isinstance(d_info, dict):
                pre_downloads_snapshot[d_guid] = dict(d_info)
    pre_target_ids: set[str] = set()
    if hasattr(client, "call"):
        try:
            pre_targets = client.call("Target.getTargets").get("targetInfos") or []
            pre_target_ids = {
                str(t.get("targetId"))
                for t in pre_targets
                if isinstance(t, dict) and t.get("type") == "page" and t.get("targetId")
            }
        except Exception:
            pass
    completed = 0
    uncertain = False
    data: dict[str, Any] = {}
    switched_via_tab_ref = False
    try:
        for step in actions:
            kind, ref = step["kind"], step["ref"]
            if kind == "click" and ref.startswith("tab_"):
                target_tid = ref[4:].strip()
                if not target_tid or (pre_target_ids and target_tid not in pre_target_ids):
                    raise RuntimeError(f"Unknown tab target ref: {ref}")
                session_id = switch_to_target(client, target_tid)
                starting_tid = target_tid
                switched_via_tab_ref = True
                completed += 1
                ensure_helpers(client, session_id)
                data = {"url": eval_json(client, session_id, "location.href") or "", "preTextLen": 0}
                continue
            # Preflight catches stale refs before a mutation is dispatched.
            if not eval_json(client, session_id, f"Boolean(window.__rakazoPageBrowser.resolve({json.dumps(ref)}))"):
                raise RuntimeError("Stale element ref. Take a fresh snapshot.")
            arguments = json.dumps(ref)
            if kind != "click":
                arguments += ", " + json.dumps(step["text"])
            if step.get("origin"):
                arguments += ", " + json.dumps(step["origin"])
            uncertain = True
            data = eval_json(client, session_id, f"window.__rakazoPageBrowser.{kind}({arguments})")
            if not isinstance(data, dict):
                raise RuntimeError("Action response unavailable")
            completed += 1
            uncertain = False
        if (
            not switched_via_tab_ref
            and hasattr(client, "call")
            and any(s.get("kind") == "click" for s in actions)
        ):
            is_Cdp = isinstance(client, CdpClient)
            post_deadline = time.monotonic() + (5.0 if is_Cdp else 0.05)
            wait_for_change_until = time.monotonic() + (2.5 if is_Cdp else 0.02)
            initial_post_url = str(data.get("url") or "") if isinstance(data, dict) else ""
            initial_text_len = int(data.get("preTextLen") or 0) if isinstance(data, dict) else 0
            last_seen_url = initial_post_url
            stable_ticks = 0
            if is_Cdp:
                time.sleep(0.25)
            while True:
                try:
                    post_targets = client.call("Target.getTargets").get("targetInfos") or []
                    new_pages = [
                        t
                        for t in post_targets
                        if isinstance(t, dict)
                        and t.get("type") == "page"
                        and str(t.get("targetId") or "") not in pre_target_ids
                    ]
                    if new_pages:
                        new_page = new_pages[-1]
                        new_tid = str(new_page["targetId"])
                        opener_tid = str(new_page.get("openerId") or starting_tid or "")
                        opener_map = getattr(client, "_opener_map", None)
                        if opener_tid and isinstance(opener_map, dict):
                            opener_map[new_tid] = opener_tid
                        session_id = switch_to_target(client, new_tid)
                        starting_tid = new_tid
                        pre_target_ids.add(new_tid)
                        if is_Cdp:
                            time.sleep(0.25)
                        break
                except Exception:
                    pass
                if not is_Cdp and time.monotonic() >= post_deadline:
                    break
                try:
                    ensure_world(client, session_id)
                    state = eval_json(
                        client,
                        session_id,
                        """({
                            url: location.href,
                            ready: document.readyState,
                            textLen: (document.body && document.body.innerText ? document.body.innerText.length : 0),
                            hasInput: Boolean(document.querySelector('input:not([type="hidden"]), textarea')),
                            hasLoadingOverlay: Boolean(document.querySelector('ion-loading, [aria-busy="true"]') || /signing in\\.\\.\\./i.test(document.body && document.body.innerText ? document.body.innerText : ''))
                        })""",
                    )
                except Exception:
                    stable_ticks = 0
                    if not is_Cdp or time.monotonic() >= post_deadline:
                        break
                    time.sleep(0.2)
                    continue
                if not isinstance(state, dict):
                    stable_ticks = 0
                    if not is_Cdp or time.monotonic() >= post_deadline:
                        break
                    time.sleep(0.2)
                    continue
                cur_url = str(state.get("url") or "")
                ready = str(state.get("ready") or "")
                cur_text_len = int(state.get("textLen") or 0)
                has_input = bool(state.get("hasInput"))
                has_loading_overlay = bool(state.get("hasLoadingOverlay"))
                url_changed = bool(cur_url and initial_post_url and cur_url != initial_post_url)
                dom_changed = abs(cur_text_len - initial_text_len) >= 5
                if has_loading_overlay and not url_changed:
                    stable_ticks = 0
                    if not is_Cdp or time.monotonic() >= post_deadline:
                        break
                    time.sleep(0.25)
                    continue
                has_active_download = False
                if isinstance(getattr(client, "_downloads", None), dict):
                    for d_guid, d_info in client._downloads.items():
                        if not isinstance(d_info, dict):
                            continue
                        is_new_or_updated = (
                            d_guid not in pre_downloads_snapshot
                            or d_info.get("updatedSeq", 0) > pre_download_seq
                            or d_info != pre_downloads_snapshot.get(d_guid)
                        )
                        if is_new_or_updated and d_info.get("state") == "inProgress":
                            has_active_download = True
                            break
                if has_active_download and time.monotonic() < post_deadline:
                    time.sleep(0.2)
                    continue
                if not url_changed and not dom_changed:
                    if is_Cdp and time.monotonic() < wait_for_change_until:
                        time.sleep(0.2)
                        continue
                    break
                if any(
                    token in cur_url
                    for token in ("/__/auth/handler", "/o/oauth2/", "/ServiceLogin")
                ):
                    stable_ticks = 0
                    if not is_Cdp or time.monotonic() >= post_deadline:
                        break
                    time.sleep(0.25)
                    continue
                if ready != "complete":
                    stable_ticks = 0
                    if not is_Cdp or time.monotonic() >= post_deadline:
                        break
                    time.sleep(0.2)
                    continue
                if "accounts.google.com" in cur_url and not has_input:
                    stable_ticks = 0
                    if not is_Cdp or time.monotonic() >= post_deadline:
                        break
                    time.sleep(0.25)
                    continue
                if cur_url != last_seen_url:
                    last_seen_url = cur_url
                    stable_ticks = 0
                    if not is_Cdp or time.monotonic() >= post_deadline:
                        break
                    time.sleep(0.25)
                    continue
                stable_ticks += 1
                if stable_ticks >= 1 or time.monotonic() >= post_deadline:
                    break
                time.sleep(0.2)

            # Check if a child popup/tab navigated back to its opener tab's URL path
            opener_map = getattr(client, "_opener_map", None)
            if starting_tid and isinstance(opener_map, dict) and starting_tid in opener_map:
                parent_tid = opener_map.get(starting_tid)
                if parent_tid and parent_tid != starting_tid and parent_tid in pre_target_ids:
                    try:
                        child_url = str(eval_json(client, session_id, "location.href") or "")
                        targets_now = client.call("Target.getTargets").get("targetInfos") or []
                        parent_info = next(
                            (t for t in targets_now if isinstance(t, dict) and str(t.get("targetId")) == parent_tid),
                            None,
                        )
                        parent_url = str((parent_info or {}).get("url") or "")
                        if child_url and parent_url and urlsplit(child_url).path == urlsplit(parent_url).path:
                            parent_session = switch_to_target(client, parent_tid)
                            ensure_helpers(client, parent_session)
                            parent_dom_gen = eval_json(
                                client,
                                parent_session,
                                "(window.__rakazoPageBrowser && window.__rakazoPageBrowser._docState ? window.__rakazoPageBrowser._docState.domGeneration : 0)",
                            )
                            if not (isinstance(parent_dom_gen, int) and parent_dom_gen > 0):
                                try:
                                    client.call("Page.reload", {}, session_id=parent_session)
                                    if isinstance(client, CdpClient):
                                        time.sleep(0.35)
                                except Exception:
                                    pass
                            session_id = parent_session
                    except Exception:
                        pass
        try:
            snap = snapshot(client, session_id)
        except Exception:
            if isinstance(client, CdpClient):
                time.sleep(0.35)
                session_id = attach_page(client)
                snap = snapshot(client, session_id)
            else:
                raise
        touched_guids: set[str] = set()
        post_downloads_map = getattr(client, "_downloads", None)
        if isinstance(post_downloads_map, dict):
            for d_guid, d_info in post_downloads_map.items():
                if not isinstance(d_guid, str) or not isinstance(d_info, dict):
                    continue
                if (
                    d_guid not in pre_downloads_snapshot
                    or (
                        isinstance(d_info.get("updatedSeq"), int)
                        and pre_download_seq > 0
                        and int(d_info["updatedSeq"]) > pre_download_seq
                    )
                    or d_info != pre_downloads_snapshot.get(d_guid)
                ):
                    touched_guids.add(d_guid)
        downloads = collect_download_receipts(client, only_guids=touched_guids)
        return {
            **snap,
            "completed": completed,
            **({"downloads": downloads} if downloads else {}),
        }
    except Exception as exc:
        err_msg = str(exc)
        pre_dispatch_markers = (
            "Stale element ref",
            "Unknown element ref",
            "Element is occluded",
            "Element is disabled",
            "Element is read-only",
            "Website logins can only",
            "The page is not on the site",
            "A saved login can only",
            "Input type requires desktop tools",
            "Element is not fillable",
            "Unknown tab target ref",
        )
        error_code: str | None = None
        if "Stale element ref" in err_msg or "Unknown element ref" in err_msg:
            error_code = "STALE_REF"
        elif "Element is occluded" in err_msg:
            error_code = "ELEMENT_OCCLUDED"
        if completed == 0 and any(marker in err_msg for marker in pre_dispatch_markers):
            uncertain = False
        rejections = getattr(client, "_stale_ref_rejections", None)
        if error_code and isinstance(rejections, list):
            rejections.append(
                {
                    "errorCode": error_code,
                    "error": err_msg,
                    "targetId": starting_tid,
                    "ts": round(time.time(), 3),
                }
            )
            if hasattr(client, "save_persisted_state"):
                client.save_persisted_state()
        return {
            "ok": False,
            "completed": completed,
            "uncertain": uncertain,
            **({"errorCode": error_code} if error_code else {}),
            "error": err_msg,
            "fallback": "computer_act",
        }


MAX_DOWNLOAD_HASH_BYTES = 50 * 1024 * 1024
HASH_CHUNK_BYTES = 65_536


def hash_file_bounded(file_path: str, max_bytes: int = MAX_DOWNLOAD_HASH_BYTES) -> tuple[int, str | None, str | None]:
    size = os.path.getsize(file_path)
    if size > max_bytes:
        return size, None, "exceeds_50mb_limit"
    digest = hashlib.sha256()
    total_read = 0
    with open(file_path, "rb") as fh:
        while True:
            chunk = fh.read(HASH_CHUNK_BYTES)
            if not chunk:
                break
            total_read += len(chunk)
            if total_read > max_bytes:
                return total_read, None, "exceeds_50mb_limit"
            digest.update(chunk)
    return total_read, digest.hexdigest(), None


def _is_within_directory(target_dir: str, candidate_path: str) -> bool:
    try:
        real_dir = os.path.realpath(target_dir)
        real_candidate = os.path.realpath(candidate_path)
        return (
            real_candidate != real_dir
            and os.path.commonpath([real_dir, real_candidate]) == real_dir
        )
    except (ValueError, OSError):
        return False


def resolve_download_path(
    target_dir: str,
    guid: str,
    reported_path: str,
    *,
    enforce_dir: bool = True,
) -> str | None:
    candidate = (reported_path or "").strip()
    if candidate:
        if "\x00" in candidate:
            return None
        resolved = candidate if os.path.isabs(candidate) or not target_dir else os.path.join(target_dir, candidate)
        if enforce_dir and target_dir:
            if not _is_within_directory(target_dir, resolved):
                return None
        if os.path.isfile(resolved):
            return resolved
        return None
    clean_guid = (guid or "").strip()
    if (
        clean_guid
        and "\x00" not in clean_guid
        and "/" not in clean_guid
        and "\\" not in clean_guid
        and clean_guid not in (".", "..")
        and target_dir
    ):
        guid_path = os.path.join(target_dir, clean_guid)
        if os.path.isfile(guid_path) and _is_within_directory(target_dir, guid_path):
            return guid_path
    return None


def collect_download_receipts(
    client: Any,
    download_dir: str | None = None,
    max_hash_bytes: int = MAX_DOWNLOAD_HASH_BYTES,
    *,
    browser_context_id: str | None = None,
    target_id: str | None = None,
    frame_id: str | None = None,
    only_guids: set[str] | None = None,
) -> list[dict[str, Any]]:
    client_dir = getattr(client, "_active_download_dir", None)
    active_dir = client_dir if isinstance(client_dir, str) and client_dir else None
    explicit_dir = download_dir or os.environ.get("RAKAZO_DOWNLOAD_DIR") or active_dir
    target_dir = explicit_dir or os.path.expanduser("~/Downloads")
    enforce_dir = True

    client_ctx = getattr(client, "_active_browser_context_id", None)
    expected_ctx = (
        browser_context_id
        if isinstance(browser_context_id, str) and browser_context_id
        else (client_ctx if isinstance(client_ctx, str) and client_ctx else None)
    )
    client_tid = getattr(client, "_active_target_id", None)
    expected_tid = (
        target_id
        if isinstance(target_id, str) and target_id
        else (client_tid if isinstance(client_tid, str) and client_tid else None)
    )
    client_fids = getattr(client, "_active_frame_ids", None)
    active_frame_set = (
        {f for f in client_fids if isinstance(f, str) and f}
        if isinstance(client_fids, (set, list, tuple))
        else set()
    )
    client_fid = getattr(client, "_active_frame_id", None)
    if isinstance(client_fid, str) and client_fid:
        active_frame_set.add(client_fid)
    expected_fid = frame_id if isinstance(frame_id, str) and frame_id else None

    receipts: list[dict[str, Any]] = []
    downloads = getattr(client, "_downloads", None)
    if not isinstance(downloads, dict):
        return receipts

    filtered_items: list[tuple[str, dict[str, Any], str | None]] = []
    realpath_counts: dict[str, int] = {}

    for raw_guid, info in downloads.items():
        if not isinstance(info, dict):
            continue
        guid = str(raw_guid or info.get("guid") or "").strip()
        if not guid:
            continue
        if only_guids is not None and guid not in only_guids:
            continue

        entry_ctx = info.get("browserContextId") if isinstance(info.get("browserContextId"), str) else ""
        entry_tid = info.get("targetId") if isinstance(info.get("targetId"), str) else ""
        entry_fid = info.get("frameId") if isinstance(info.get("frameId"), str) else ""
        entry_dir = info.get("downloadDir") if isinstance(info.get("downloadDir"), str) else ""

        if expected_ctx and entry_ctx and entry_ctx != expected_ctx:
            continue
        if expected_tid and entry_tid and entry_tid != expected_tid:
            continue
        if expected_fid and entry_fid and entry_fid != expected_fid:
            continue
        if (
            not expected_fid
            and active_frame_set
            and entry_fid
            and (not entry_tid or entry_tid == expected_tid)
            and entry_fid not in active_frame_set
        ):
            continue
        if download_dir and entry_dir:
            try:
                if os.path.realpath(entry_dir) != os.path.realpath(download_dir):
                    continue
            except OSError:
                continue

        reported_path = str(info.get("filePath") or "")
        state = str(info.get("state") or "unknown")
        received_bytes = (
            int(info["receivedBytes"])
            if isinstance(info.get("receivedBytes"), int) and not isinstance(info.get("receivedBytes"), bool)
            else None
        )
        total_bytes = (
            int(info["totalBytes"])
            if isinstance(info.get("totalBytes"), int) and not isinstance(info.get("totalBytes"), bool)
            else None
        )
        bytes_complete = not (
            isinstance(received_bytes, int)
            and isinstance(total_bytes, int)
            and total_bytes > 0
            and received_bytes < total_bytes
        )
        verified_path = (
            resolve_download_path(
                target_dir,
                guid,
                reported_path,
                enforce_dir=enforce_dir,
            )
            if state == "completed" and bytes_complete
            else None
        )
        if verified_path:
            try:
                real_p = os.path.realpath(verified_path)
                realpath_counts[real_p] = realpath_counts.get(real_p, 0) + 1
            except OSError:
                verified_path = None
        filtered_items.append((guid, info, verified_path))

    for guid, info, candidate_verified_path in filtered_items:
        suggested = str(info.get("suggestedFilename") or "")
        state = str(info.get("state") or "unknown")
        received_bytes = (
            int(info["receivedBytes"])
            if isinstance(info.get("receivedBytes"), int) and not isinstance(info.get("receivedBytes"), bool)
            else None
        )
        total_bytes = (
            int(info["totalBytes"])
            if isinstance(info.get("totalBytes"), int) and not isinstance(info.get("totalBytes"), bool)
            else None
        )
        verified_path = candidate_verified_path
        if verified_path:
            try:
                if realpath_counts.get(os.path.realpath(verified_path), 0) > 1:
                    # Ambiguous duplicate file path claim across multiple GUIDs
                    verified_path = None
            except OSError:
                verified_path = None

        entry: dict[str, Any] = {
            "guid": guid,
            "url": str(info.get("url") or ""),
            "name": suggested or (os.path.basename(verified_path) if verified_path else "") or "download",
            "state": state,
            "pathStatus": "known" if verified_path else "unknown",
        }
        for meta_key in ("frameId", "targetId", "browserContextId"):
            meta_val = info.get(meta_key)
            if isinstance(meta_val, str) and meta_val:
                entry[meta_key] = meta_val
        if received_bytes is not None:
            entry["receivedBytes"] = received_bytes
        if total_bytes is not None:
            entry["totalBytes"] = total_bytes
        if verified_path:
            try:
                size, sha256_hex, skip_reason = hash_file_bounded(verified_path, max_bytes=max_hash_bytes)
                size_mismatch = (
                    (isinstance(total_bytes, int) and total_bytes > 0 and size != total_bytes)
                    or (isinstance(received_bytes, int) and received_bytes > 0 and size != received_bytes)
                )
                if size_mismatch:
                    entry["pathStatus"] = "unknown"
                else:
                    entry["path"] = verified_path
                    entry["size"] = size
                    if sha256_hex is not None:
                        entry["sha256"] = sha256_hex
                    if skip_reason is not None:
                        entry["hashSkippedReason"] = skip_reason
            except OSError:
                entry.pop("path", None)
                entry["pathStatus"] = "unknown"
        receipts.append(entry)
    return receipts


def click_selector(
    client: CdpClient,
    session_id: str,
    args: dict[str, Any],
) -> dict[str, Any]:
    selector = str(args.get("selector") or "").strip()
    if not selector:
        return {"ok": False, "clicked": False, "error": "selector is required"}
    ensure_helpers(client, session_id)
    try:
        res = eval_json(
            client,
            session_id,
            f"""(() => {{
                const sel = {json.dumps(selector)};
                let el = null;
                if (/^e[0-9a-f]+$/i.test(sel)) {{
                    if (window.__rakazoPageBrowser && typeof window.__rakazoPageBrowser.resolve === "function") {{
                        el = window.__rakazoPageBrowser.resolve(sel);
                    }}
                    if (!el || el.isConnected === false) {{
                        return {{ ok: false, clicked: false, error: `Stale element ref: ${{sel}}` }};
                    }}
                }} else {{
                    try {{
                        el = document.querySelector(sel);
                    }} catch (err) {{
                        return {{ ok: false, clicked: false, error: `Invalid selector: ${{sel}}` }};
                    }}
                    if (!el || el.isConnected === false) {{
                        return {{ ok: false, clicked: false, error: `No element matches selector: ${{sel}}` }};
                    }}
                }}
                const style = window.getComputedStyle ? window.getComputedStyle(el) : null;
                if (style && (style.display === "none" || style.visibility === "hidden" || style.opacity === "0")) {{
                    return {{ ok: false, clicked: false, error: `Element has no visible box: ${{sel}}` }};
                }}
                const rect = el.getBoundingClientRect();
                if (rect.width <= 0 || rect.height <= 0) {{
                    return {{ ok: false, clicked: false, error: `Element has no visible box: ${{sel}}` }};
                }}
                let cur = el;
                while (cur) {{
                    if (
                        (cur.hasAttribute && cur.hasAttribute("disabled")) ||
                        (cur.getAttribute && cur.getAttribute("aria-disabled") === "true") ||
                        (cur.matches && cur.matches(":disabled")) ||
                        cur.disabled === true
                    ) {{
                        return {{ ok: false, clicked: false, error: `Element is disabled: ${{sel}}` }};
                    }}
                    cur = cur.parentElement || (cur.getRootNode && cur.getRootNode().host);
                }}
                el.focus();
                el.click();
                return {{
                    ok: true,
                    clicked: true,
                    url: location.href,
                    title: (document.title || "").slice(0, 200),
                }};
            }})()""",
        )
        if isinstance(res, dict):
            return res
        return {"ok": False, "clicked": False, "error": "click_selector returned non-object"}
    except Exception as exc:
        return {"ok": False, "clicked": False, "error": str(exc)}


SENSITIVE_JSON_KEY_SUBSTRINGS = (
    "password",
    "passwd",
    "pwd",
    "secret",
    "token",
    "authorization",
    "cookie",
    "set-cookie",
    "api_key",
    "apikey",
    "client_secret",
    "private_key",
    "session_id",
    "sessionid",
    "otp",
    "totp",
)
MAX_HARVEST_ITEM_BYTES = 16 * 1024
MAX_HARVEST_TOTAL_BYTES = 64 * 1024


def redact_sensitive_json(value: Any, depth: int = 0) -> Any:
    if depth > 12:
        return "[TRUNCATED_DEPTH]"
    if isinstance(value, dict):
        sanitized: dict[str, Any] = {}
        for k, v in value.items():
            key_str = str(k)
            key_lower = key_str.lower()
            if any(marker in key_lower for marker in SENSITIVE_JSON_KEY_SUBSTRINGS):
                sanitized[key_str] = "[REDACTED]"
            else:
                sanitized[key_str] = redact_sensitive_json(v, depth + 1)
        return sanitized
    if isinstance(value, list):
        return [redact_sensitive_json(item, depth + 1) for item in value[:100]]
    if isinstance(value, str) and len(value) > 4000:
        return value[:4000] + "...[TRUNCATED]"
    return value


def materialize_api_entries(client: CdpClient, session_id: str) -> list[dict[str, Any]]:
    store = getattr(client, "_api_responses", None)
    harvested = getattr(client, "_harvested_apis", None)
    if not isinstance(harvested, list):
        harvested = []
        setattr(client, "_harvested_apis", harvested)
    if not isinstance(store, dict):
        return harvested

    pending_entries: list[dict[str, Any]] = []
    for key in (session_id, ""):
        bucket = store.get(key)
        if isinstance(bucket, list) and bucket:
            pending_entries.extend(bucket)
            store[key] = []

    for item in pending_entries:
        if not isinstance(item, dict):
            continue
        u = str(item.get("url") or "")
        req_id = str(item.get("requestId") or "")
        body_data: Any = item.get("data")
        if body_data is None and req_id:
            try:
                raw_body = client.call(
                    "Network.getResponseBody",
                    {"requestId": req_id},
                    session_id=session_id,
                    timeout_s=5.0,
                )
                body_str = str(raw_body.get("body") or "")
                if raw_body.get("base64Encoded"):
                    body_str = base64.b64decode(body_str).decode("utf-8", errors="replace")
                try:
                    body_data = json.loads(body_str)
                except Exception:
                    body_data = body_str[:4000]
            except Exception:
                body_data = None
        if body_data is not None:
            body_data = redact_sensitive_json(body_data)
            try:
                encoded = json.dumps(body_data, ensure_ascii=False)
                if len(encoded.encode("utf-8")) > MAX_HARVEST_ITEM_BYTES:
                    body_data = {
                        "truncated": True,
                        "preview": encoded[:4000],
                    }
            except Exception:
                body_data = str(body_data)[:4000]
        record: dict[str, Any] = {
            "url": u,
            "status": item.get("status"),
            "mimeType": item.get("mimeType"),
            **({"data": body_data} if body_data is not None else {}),
        }
        harvested.append(record)
    if len(harvested) > 50:
        del harvested[:-50]
    if hasattr(client, "save_persisted_state"):
        client.save_persisted_state()
    return harvested


def harvest_json_apis(
    client: CdpClient,
    session_id: str,
    args: dict[str, Any],
) -> dict[str, Any]:
    url_filter = str(args.get("urlFilter") or "").strip().lower()
    max_items = min(max(int(args.get("maxItems") or 10), 1), 50)
    entries = materialize_api_entries(client, session_id)
    matched: list[dict[str, Any]] = []
    total_bytes = 0
    for item in reversed(entries):
        if not isinstance(item, dict):
            continue
        u = str(item.get("url") or "")
        if url_filter and url_filter not in u.lower():
            continue
        sanitized_item: dict[str, Any] = {
            "url": u,
            "status": item.get("status"),
            "mimeType": item.get("mimeType"),
        }
        if "data" in item and item["data"] is not None:
            sanitized_item["data"] = redact_sensitive_json(item["data"])
        item_bytes = len(json.dumps(sanitized_item, ensure_ascii=False).encode("utf-8"))
        if matched and total_bytes + item_bytes > MAX_HARVEST_TOTAL_BYTES:
            break
        total_bytes += item_bytes
        matched.append(sanitized_item)
        if len(matched) >= max_items:
            break
    return {"ok": True, "apis": matched}


def bezier_pointer_points(
    x0: float,
    y0: float,
    x1: float,
    y1: float,
    steps: int = 12,
) -> list[tuple[int, int]]:
    steps = max(2, min(steps, 40))
    dx = x1 - x0
    dy = y1 - y0
    cx1 = x0 + dx * 0.28 - dy * 0.12
    cy1 = y0 + dy * 0.18 + dx * 0.08
    cx2 = x0 + dx * 0.72 + dy * 0.09
    cy2 = y0 + dy * 0.84 - dx * 0.06
    points: list[tuple[int, int]] = []
    for i in range(1, steps + 1):
        t = i / steps
        inv = 1.0 - t
        bx = (
            (inv**3) * x0
            + 3 * (inv**2) * t * cx1
            + 3 * inv * (t**2) * cx2
            + (t**3) * x1
        )
        by = (
            (inv**3) * y0
            + 3 * (inv**2) * t * cy1
            + 3 * inv * (t**2) * cy2
            + (t**3) * y1
        )
        points.append((int(round(bx)), int(round(by))))
    return points


STEALTH_INIT_SCRIPT = r"""
(() => {
  try {
    Object.defineProperty(navigator, 'webdriver', { get: () => false });
    if (!window.chrome) {
      window.chrome = { runtime: {} };
    }
    Object.defineProperty(navigator, 'languages', { get: () => ['en-US', 'en', 'th-TH', 'th'] });
  } catch {}
})();
"""


def apply_stealth_evasion(client: CdpClient, session_id: str) -> dict[str, Any]:
    client.call(
        "Page.addScriptToEvaluateOnNewDocument",
        {"source": STEALTH_INIT_SCRIPT},
        session_id=session_id,
    )
    try:
        client.call(
            "Runtime.evaluate",
            {"expression": STEALTH_INIT_SCRIPT, "returnByValue": True},
            session_id=session_id,
        )
    except Exception:
        pass
    return {"ok": True, "stealth": True}


def observe_challenge_state(client: CdpClient, session_id: str) -> dict[str, Any] | None:
    try:
        ensure_world(client, session_id)
        info = eval_json(
            client,
            session_id,
            r"""(() => {
              const tokenInputs = Array.from(
                document.querySelectorAll(
                  '[name="cf-turnstile-response"], [name="g-recaptcha-response"], [name="h-captcha-response"]'
                )
              );
              const tokens = tokenInputs
                .map((el) => (typeof el.value === "string" ? el.value.trim() : ""))
                .filter((v) => v.length > 0);
              const hasToken = tokens.length > 0;
              const tokenValue = tokens.join("|");
              const hasChallengeDom = Boolean(
                document.querySelector(
                  '#challenge-running, #challenge-form, #cf-challenge-running, iframe[src*="challenges.cloudflare.com"], iframe[src*="turnstile"], iframe[src*="recaptcha"], iframe[src*="hcaptcha"], .cf-turnstile, .g-recaptcha, .h-captcha'
                )
              );
              let httpStatus = null;
              try {
                const nav = performance.getEntriesByType("navigation")[0];
                if (nav && typeof nav.responseStatus === "number" && nav.responseStatus > 0) {
                  httpStatus = nav.responseStatus;
                }
              } catch (e) {}
              const title = (document.title || "").slice(0, 200);
              const bodySnippet = (document.body && document.body.innerText ? document.body.innerText : "").slice(0, 1000);
              return { hasToken, tokenValue, hasChallengeDom, httpStatus, title, bodySnippet, url: location.href };
            })()""",
        )
        return info if isinstance(info, dict) else None
    except Exception:
        return None


def _is_error_page_observation(
    client: CdpClient,
    session_id: str,
    obs: dict[str, Any],
) -> bool:
    url = str(obs.get("url") or "").strip()
    if not url.startswith(("http://", "https://")):
        return True
    obs_status = obs.get("httpStatus")
    if isinstance(obs_status, int) and not isinstance(obs_status, bool) and obs_status >= 400:
        return True
    doc_resp = find_document_response(client, session_id, None, None)
    if isinstance(doc_resp, dict):
        cdp_status = doc_resp.get("status")
        if isinstance(cdp_status, int) and not isinstance(cdp_status, bool) and cdp_status >= 400:
            return True
    if find_document_failure(client, session_id, None, None) is not None:
        return True
    combined = f"{obs.get('title') or ''}\n{obs.get('bodySnippet') or ''}".lower()
    error_markers = (
        "502 bad gateway",
        "503 service temporarily unavailable",
        "504 gateway time-out",
        "500 internal server error",
        "403 forbidden",
        "404 not found",
        "this site can’t be reached",
        "this site can't be reached",
        "err_connection_",
        "err_name_not_resolved",
    )
    return any(marker in combined for marker in error_markers)


def solve_challenge(
    client: CdpClient,
    session_id: str,
    args: dict[str, Any],
) -> dict[str, Any]:
    target_x = args.get("x")
    target_y = args.get("y")
    if not (isinstance(target_x, (int, float)) and isinstance(target_y, (int, float))):
        ensure_helpers(client, session_id)
        box = eval_json(
            client,
            session_id,
            r"""(() => {
              const sel = 'iframe[src*="challenges.cloudflare.com"], iframe[src*="turnstile"], iframe[src*="hcaptcha"], iframe[src*="recaptcha"], .cf-turnstile, #challenge-stage input[type="checkbox"]';
              const el = document.querySelector(sel);
              if (!el) return null;
              const r = el.getBoundingClientRect();
              if (r.width <= 0 || r.height <= 0) return null;
              return { x: Math.round(r.left + Math.min(32, r.width / 2)), y: Math.round(r.top + r.height / 2) };
            })()""",
        )
        if not isinstance(box, dict):
            return {
                "ok": False,
                "dispatched": False,
                "status": "no_widget",
                "solved": False,
                "businessGoalVerified": False,
                "requiresTakeover": True,
                "fallback": "request_takeover",
                "error": "No challenge widget located on page",
            }
        target_x = int(box["x"])
        target_y = int(box["y"])
    pre = observe_challenge_state(client, session_id)
    start_x = int(args.get("startX") or max(10, int(target_x) - 140))
    start_y = int(args.get("startY") or max(10, int(target_y) - 90))
    trajectory = bezier_pointer_points(start_x, start_y, float(target_x), float(target_y), steps=12)
    for px, py in trajectory:
        client.call(
            "Input.dispatchMouseEvent",
            {"type": "mouseMoved", "x": px, "y": py, "button": "none"},
            session_id=session_id,
        )
    fx, fy = trajectory[-1]
    client.call(
        "Input.dispatchMouseEvent",
        {"type": "mousePressed", "x": fx, "y": fy, "button": "left", "clickCount": 1},
        session_id=session_id,
    )
    client.call(
        "Input.dispatchMouseEvent",
        {"type": "mouseReleased", "x": fx, "y": fy, "button": "left", "clickCount": 1},
        session_id=session_id,
    )
    settle_ms = int(args.get("settleMs", 250))
    if settle_ms > 0:
        time.sleep(min(settle_ms, 5000) / 1000.0)
    post = observe_challenge_state(client, session_id)
    if isinstance(post, dict):
        if _is_error_page_observation(client, session_id, post):
            return {
                "ok": False,
                "dispatched": True,
                "status": "navigation_error",
                "solved": False,
                "businessGoalVerified": False,
                "requiresTakeover": True,
                "fallback": "request_takeover",
                "clickedAt": {"x": fx, "y": fy},
                "trajectoryPoints": len(trajectory),
                "error": "Page navigated to an error page during challenge verification; request user takeover.",
            }
        post_has_token = bool(post.get("hasToken"))
        post_token_val = str(post.get("tokenValue") or "")
        pre_has_token = bool(pre.get("hasToken")) if isinstance(pre, dict) else False
        pre_token_val = str(pre.get("tokenValue") or "") if isinstance(pre, dict) else ""
        # A pre-existing token that did not change after clicking is stale.
        stale_preexisting_token = pre_has_token and (
            not post_has_token or post_token_val == pre_token_val
        )
        fresh_token = post_has_token and not stale_preexisting_token
        post_has_dom = bool(post.get("hasChallengeDom"))
        post_text_challenge = detect_challenge_page(
            str(post.get("title") or ""),
            str(post.get("bodySnippet") or ""),
            False,
            post.get("httpStatus") if isinstance(post.get("httpStatus"), int) else None,
        )
        still_challenged = (
            stale_preexisting_token
            or post_has_dom
            or (not fresh_token and post_text_challenge is not None)
        )
        if not still_challenged and (fresh_token or not post_has_dom):
            return {
                "ok": True,
                "dispatched": True,
                "status": "verified",
                "solved": True,
                "businessGoalVerified": False,
                "clickedAt": {"x": fx, "y": fy},
                "trajectoryPoints": len(trajectory),
            }
        return {
            "ok": False,
            "dispatched": True,
            "status": "still_challenged",
            "solved": False,
            "businessGoalVerified": False,
            "requiresTakeover": True,
            "fallback": "request_takeover",
            "clickedAt": {"x": fx, "y": fy},
            "trajectoryPoints": len(trajectory),
            "error": "Challenge remains active after click; request user takeover.",
        }
    return {
        "ok": False,
        "dispatched": True,
        "status": "unknown",
        "solved": False,
        "businessGoalVerified": False,
        "requiresTakeover": True,
        "fallback": "request_takeover",
        "clickedAt": {"x": fx, "y": fy},
        "trajectoryPoints": len(trajectory),
        "error": "Challenge state could not be verified after click; request user takeover.",
    }


def activate_selected_page(client: CdpClient, session_id: str) -> None:
    # A persisted selected tab can be hidden after Chromium restores a profile.
    # Keep product observations/actions on the page shown for human takeover.
    client.call("Page.bringToFront", session_id=session_id, timeout_s=3.0)
    result = client.call(
        "Runtime.evaluate",
        {"expression": 'document.visibilityState === "visible"', "returnByValue": True},
        session_id=session_id,
        timeout_s=3.0,
    )
    if result.get("exceptionDetails") or result.get("result", {}).get("value") is not True:
        raise RuntimeError("Selected browser tab is not visible; refusing a hidden-page operation")


def flush_and_persist_state(client: CdpClient, session_id: str | None = None) -> None:
    if session_id:
        try:
            if getattr(client, "_sock", None) is not None:
                time.sleep(0.25)
                client.call(
                    "Runtime.evaluate",
                    {"expression": "1", "returnByValue": True},
                    session_id=session_id,
                    timeout_s=2.0,
                )
            materialize_api_entries(client, session_id)
        except Exception:
            pass
    if hasattr(client, "save_persisted_state"):
        client.save_persisted_state()


def exit_when_stdin_closes() -> None:
    """The supervisor owns this pipe; losing it cancels this helper, not Chromium."""
    try:
        while os.read(0, 1024):
            pass
    finally:
        os._exit(130)


def read_stdin_line() -> str:
    """Read one line from fd 0 unbuffered, leaving the rest of stdin for the EOF watcher."""
    data = bytearray()
    while len(data) < 1_048_576:
        chunk = os.read(0, 1)
        if not chunk or chunk == b"\n":
            break
        data += chunk
    return data.decode("utf-8")


def run(argv: list[str]) -> int:
    stdin_args = (
        read_stdin_line() if os.environ.get("RAKAZO_BROWSER_ARGS_STDIN") == "1" else None
    )
    if os.environ.get("RAKAZO_BROWSER_WATCH_STDIN") == "1":
        threading.Thread(target=exit_when_stdin_closes, daemon=True).start()
    if len(argv) < 2:
        print(
            json.dumps(
                {
                    "ok": False,
                    "error": "usage: rakazo-page-browser <command> [json-args]",
                    "fallback": "computer_act",
                }
            )
        )
        return 2
    command = argv[1]
    args: dict[str, Any] = {}
    raw_args = stdin_args if stdin_args is not None else (argv[2] if len(argv) >= 3 else "")
    if raw_args.strip():
        args = json.loads(raw_args)
    evidence = BrowserEvidence(os.environ.get("RAKAZO_BROWSER_RUN_ID"),
        os.environ.get("RAKAZO_BROWSER_EXECUTION_ID"), command)
    port = cdp_port()
    mutation_may_have_run = False
    try:
        wait_for_cdp(port)
        ws_url = discover_ws_url(port)
        client = CdpClient(ws_url, state_file=default_state_file(port))
        client._evidence = evidence
        client.connect()
        session_id: str | None = None
        try:
            session_id = attach_page(client)
            activate_selected_page(client, session_id)
            evidence_call(client, "selected", session_id, getattr(client, "_active_target_id", None))
            if command == "navigate":
                result = navigate(client, session_id, str(args.get("url") or ""))
            elif command == "snapshot":
                result = snapshot(client, session_id)
            elif command == "act":
                actions = args.get("actions")
                if not isinstance(actions, list):
                    raise RuntimeError("actions must be an array")
                mutation_may_have_run = True
                result = act(client, session_id, actions)
            elif command == "click_selector":
                result = click_selector(client, session_id, args)
            elif command == "downloads":
                wait_ms_raw = args.get("waitForCompletionMs")
                wait_ms = (
                    min(30_000, max(0, int(wait_ms_raw)))
                    if isinstance(wait_ms_raw, int) and not isinstance(wait_ms_raw, bool)
                    else 0
                )
                wait_deadline = time.monotonic() + (wait_ms / 1000.0)
                while True:
                    flush_and_persist_state(client, session_id)
                    if time.monotonic() >= wait_deadline:
                        break
                    has_in_progress = any(
                        isinstance(d, dict) and d.get("state") == "inProgress"
                        for d in getattr(client, "_downloads", {}).values()
                    )
                    if not has_in_progress:
                        break
                    time.sleep(0.2)
                result = {
                    "ok": True,
                    "downloads": collect_download_receipts(
                        client,
                        args.get("downloadDir"),
                        browser_context_id=args.get("browserContextId"),
                        target_id=args.get("targetId"),
                        frame_id=args.get("frameId"),
                    ),
                }
            elif command == "clear_origin_storage":
                result = clear_origin_storage(client, session_id, args)
            elif command == "harvest_json":
                result = harvest_json_apis(client, session_id, args)
            elif command == "solve_challenge":
                result = solve_challenge(client, session_id, args)
            elif command == "stealth":
                result = apply_stealth_evasion(client, session_id)
            elif command == "tab_list":
                tabs = list_browser_tabs(client, active_session_id=session_id)
                result = {
                    "ok": True,
                    "activeTargetId": getattr(client, "_active_target_id", None),
                    "tabs": tabs,
                    "targetHistory": getattr(client, "_target_history", []),
                    "staleRefRejections": getattr(client, "_stale_ref_rejections", []),
                }
            elif command == "tab_switch":
                target_tid = str(args.get("targetId") or "").strip()
                if not target_tid:
                    raise RuntimeError("targetId is required for tab_switch")
                session_id = switch_to_target(client, target_tid)
                result = snapshot(client, session_id)
            elif command == "tab_close":
                tabs = list_browser_tabs(client)
                target_tid = str(args.get("targetId") or "").strip()
                url_sub = str(args.get("urlIncludes") or "").strip().lower()
                title_sub = str(args.get("titleIncludes") or "").strip().lower()
                allow_last = bool(args.get("allowLastTab", False))

                if not target_tid and (url_sub or title_sub):
                    matches = [t for t in tabs
                        if (not url_sub or url_sub in str(t.get("url") or "").lower()) and
                           (not title_sub or title_sub in str(t.get("title") or "").lower())]
                    if len(matches) != 1:
                        raise RuntimeError("Tab selector must match exactly one target; no close was sent")
                    target_tid = str(matches[0].get("targetId") or "")

                if not target_tid:
                    # Default to active target if it is a secondary/child tab
                    act_tid = getattr(client, "_active_target_id", "") or ""
                    opener_map = getattr(client, "_opener_map", {})
                    if act_tid and (act_tid in opener_map or len(tabs) > 1):
                        target_tid = act_tid

                if not target_tid:
                    raise RuntimeError("targetId is required for tab_close")

                if len(tabs) <= 1 and not allow_last:
                    raise RuntimeError("Refusing to close the last remaining browser tab (allowLastTab=False)")

                opener_map = getattr(client, "_opener_map", {})
                if not any(t.get("targetId") == target_tid for t in tabs):
                    raise RuntimeError("Requested browser target was not present before close")
                opener_tid = opener_map.get(target_tid) if isinstance(opener_map, dict) else None
                mutation_may_have_run = True
                client.call("Target.closeTarget", {"targetId": target_tid})
                # CDP's deprecated success field is not an outcome oracle. Verify
                # target removal and every survivor from the post-close inventory.
                if getattr(client, "_active_target_id", None) == target_tid:
                    rem_tabs = [t for t in list_browser_tabs(client) if t.get("targetId") != target_tid]
                    fallback_tid = opener_tid if any(t.get("targetId") == opener_tid for t in rem_tabs) else (rem_tabs[0]["targetId"] if rem_tabs else None)
                    client._active_target_id = fallback_tid
                    if fallback_tid:
                        try:
                            client.call("Target.activateTarget", {"targetId": fallback_tid})
                        except Exception:
                            pass
                time.sleep(0.15)
                rem_tabs = list_browser_tabs(client)
                remaining_ids = {t.get("targetId") for t in rem_tabs}
                if target_tid in remaining_ids:
                    raise RuntimeError("Target.closeTarget acknowledged but target is still present")
                survivors = {t.get("targetId") for t in tabs if t.get("targetId") != target_tid}
                if not survivors.issubset(remaining_ids):
                    raise RuntimeError("Another browser target disappeared during close; preservation is unverified")
                if isinstance(opener_map, dict):
                    opener_map.pop(target_tid, None)
                result = {
                    "ok": True,
                    "closedTargetId": target_tid,
                    "activeTargetId": getattr(client, "_active_target_id", None),
                    "tabs": rem_tabs,
                }
            elif command == "scroll":
                ensure_helpers(client, session_id)
                direction = str(args.get("direction") or "down")
                amount = int(args.get("amount") or 500)
                selector = str(args.get("selector") or "")
                eval_json(
                    client,
                    session_id,
                    f"window.__rakazoPageBrowser.scroll({json.dumps(direction)}, {json.dumps(amount)}, {json.dumps(selector)})",
                )
                result = snapshot(client, session_id)
            else:
                result = {
                    "ok": False,
                    "error": f"unknown command: {command}",
                    "fallback": "computer_act",
                }
                print_browser_result(result, evidence)
                return 2
            flush_and_persist_state(client, session_id)
            print_browser_result(result, evidence)
            return 0  # Structured failures preserve partial action progress.
        finally:
            flush_and_persist_state(client, session_id)
            client.close()
    except Exception as exc:  # noqa: BLE001
        print_browser_result({"ok": False, "error": str(exc), "fallback": "computer_act",
                              "uncertain": mutation_may_have_run}, evidence)
        return 0


if __name__ == "__main__":
    sys.exit(run(sys.argv))
