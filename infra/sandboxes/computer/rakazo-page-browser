      return "partial_loading";
    }
    if (!bodyText) {
      return "empty";
    }
    return "complete";
  }

  const api = {
    version: "3.0.0",
    _loginFilled: loginFilled,
    _refMap: refMap,
    _docState: docState,
    _isDispatching: false,

    snapshot() {
      docState.snapshotGeneration += 1;
      const snapGen = docState.snapshotGeneration;
      const domGen = currentDomGeneration();
      refMap.clear();
      const { rawElements, hasFrames, hasClosedShadow, frameTexts, shadowTexts, isModal, activeModal, challengeDetected, challengeType } = scanElements();
      const elements = rawElements.map(item => {
        const ref = newRef();
        refMap.set(ref, item.node);
