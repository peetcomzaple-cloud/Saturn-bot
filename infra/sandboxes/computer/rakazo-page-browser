    },

    click(ref) {
      const el = this.resolve(ref);
      if (!el) throw new Error(`Unknown element ref: ${ref}`);

      const ownerDoc = el.ownerDocument || document;
      if (ownerDoc.elementFromPoint) {
        const rect = el.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const topEl = ownerDoc.elementFromPoint(cx, cy);
        let shadowTop = topEl;
        while (shadowTop && shadowTop.shadowRoot && shadowTop.shadowRoot.elementFromPoint) {
          const inner = shadowTop.shadowRoot.elementFromPoint(cx, cy);
          if (!inner || inner === shadowTop) break;
          shadowTop = inner;
        }
        const isSameOrContained =
          !topEl ||
          topEl === el ||
          shadowTop === el ||
          containsAcrossShadow(el, topEl) ||
          containsAcrossShadow(topEl, el) ||
          containsAcrossShadow(el, shadowTop) ||
          containsAcrossShadow(shadowTop, el);
        if (!isSameOrContained) {
          const desc = `${topEl.tagName.toLowerCase()}${topEl.id ? `#${topEl.id}` : ""}`;
