    const hasChallengeDom = Boolean(
      document.querySelector &&
      document.querySelector(
        '#challenge-running, #challenge-form, #cf-challenge-running, [name="cf-turnstile-response"], [name="g-recaptcha-response"], [name="h-captcha-response"], iframe[src*="challenges.cloudflare.com"], iframe[src*="turnstile"], iframe[src*="recaptcha"], iframe[src*="hcaptcha"], .cf-turnstile, .g-recaptcha, .h-captcha'
