      const el = refMap.get(key);
      if (!el || !el.isConnected || !visible(el)) {
        const prior = docState.knownRefs.get(key);
        docState.rejectedStaleRefs.push({
          ref: key,
          reason: !el
            ? (prior ? "stale_snapshot_generation" : "unknown_ref")
            : !el.isConnected
              ? "dom_node_disconnected_or_replaced"
              : "element_hidden",
          priorSnapshotGeneration: prior ? prior.snapshotGeneration : null,
          priorDomGeneration: prior ? prior.domGeneration : null,
          currentSnapshotGeneration: docState.snapshotGeneration,
          currentDomGeneration: currentDomGeneration(),
