      document.querySelector &&
      document.querySelector(
        'input[autocomplete="one-time-code"], input[name*="otp" i], input[name*="mfa" i], input[id*="otp" i], input[id*="mfa" i], input[name*="totp" i], input[id*="totp" i]'
      )
    );
