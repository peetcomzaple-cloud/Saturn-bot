        el.textContent = String(value);
        el.dispatchEvent(new win.Event("input", { bubbles: true }));
      } else {
        throw new Error(`Element is not fillable: ${ref}`);
      }
      return { url: location.href, title: (document.title || "").slice(0, 200) };
    },

    type(ref, text) {
      const el = this.resolve(ref);
      if (!el) throw new Error(`Unknown element ref: ${ref}`);
      const holdsLogin = loginFilled.has(el);
      const result = this.fill(ref, `${"value" in el ? el.value : el.textContent || ""}${text}`);
      if (holdsLogin) loginFilled.add(el);
      return result;
    },
  };

  window.__rakazoPageBrowser = api;
  return true;
