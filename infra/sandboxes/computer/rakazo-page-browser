        url: location.href,
        title: (document.title || "").slice(0, 200),
        elements,
        tree: extracted.text + "\n" + formatTree(elements, true) + notes,
        hasFrames,
        hasClosedShadow,
        coverage,
        isModal,
        ...(activeModal ? { activeModal } : {}),
        snapshotGeneration: snapGen,
        domGeneration: domGen,
        readyState: document.readyState || "unknown",
        contentStatus,
        truncated: extracted.truncated,
        totalTextLength: extracted.totalTextLength,
        scrollY: extracted.scrollY,
        scrollHeight: extracted.scrollHeight,
        viewportHeight: extracted.viewportHeight,
        ...(docState.rejectedStaleRefs.length ? { staleRefRejections: docState.rejectedStaleRefs.slice(-10) } : {}),
        challengeDetected: Boolean(challengeDetected),
        ...(challengeType ? { challengeType } : {}),
      };
    },

    observe() {
      const { rawElements, hasFrames, hasClosedShadow, frameTexts, shadowTexts, isModal, activeModal, challengeDetected, challengeType } = scanElements();
      const elements = rawElements.map(item => {
        const { node, ...rest } = item;
        return rest;
      });
      const coverage = (hasFrames || hasClosedShadow) ? 0.75 : 1.0;
      let notes = "";
      if (isModal && activeModal) {
        notes += `\n[Active Modal/Overlay: ${activeModal}]`;
      }
      if (hasFrames) notes += "\nEmbedded frames require desktop tools.";
      if (hasClosedShadow) notes += "\nClosed Shadow DOM components require desktop tools.";
      const extracted = extractPageText(frameTexts, shadowTexts);

      return {
        url: location.href,
        title: (document.title || "").slice(0, 200),
        elements,
        tree: extracted.text + "\n" + formatTree(elements, false) + notes,
        hasFrames,
        hasClosedShadow,
        coverage,
        isModal,
        ...(activeModal ? { activeModal } : {}),
        domGeneration: currentDomGeneration(),
        readyState: document.readyState || "unknown",
        contentStatus: detectContentStatus(),
        truncated: extracted.truncated,
        totalTextLength: extracted.totalTextLength,
